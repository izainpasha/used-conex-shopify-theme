{%- comment -%}
  Used Conex — Location page hero (Figma 270:354). Same yellow-tint hero +
  zip/delivery/quote form as uc-buy-hero, plus a subtitle line for the
  per-city intro sentence. Reuses uc-buyhero__* CSS classes directly.
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-buyhero uc-font">
  {%- if section.settings.background != blank -%}
    {{ section.settings.background | image_url: width: 1920 | image_tag: class: 'uc-buyhero__bg', alt: '', loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,1920' }}
  {%- elsif section.settings.fallback_image_url != blank -%}
    {%- render 'uc-img', src: section.settings.fallback_image_url, class: 'uc-buyhero__bg', priority: true -%}
  {%- endif -%}
  <div class="uc-buyhero__overlay"></div>

  {%- assign mf_heading = page.metafields.location.hero_heading.value -%}
  {%- assign mf_subtitle = page.metafields.location.hero_subtitle.value -%}
  <div class="uc-buyhero__content">
    <h1 class="uc-buyhero__title">{{ mf_heading | default: section.settings.heading }}</h1>
    {%- assign subtitle = mf_subtitle | default: section.settings.subheading -%}
    {%- if subtitle != blank -%}
      <p class="uc-dims-hero__subtitle" style="margin-bottom: 40px;">{{ subtitle }}</p>
    {%- endif -%}

    <form class="uc-buyhero__form" action="{{ section.settings.form_action | default: '/pages/shop' }}" method="get" role="search">
      <div class="uc-buyhero__field uc-buyhero__field--zip">
        <input type="text" name="zipcode" placeholder="{{ section.settings.zip_placeholder }}" aria-label="{{ section.settings.zip_placeholder }}">
      </div>
      <div class="uc-buyhero__field uc-buyhero__field--delivery">
        <select name="isDelivery" aria-label="Delivery type">
          {%- assign opts = section.settings.delivery_options | split: ',' -%}
          {%- for opt in opts -%}
            <option value="{% if opt contains 'eliver' %}true{% else %}false{% endif %}">{{ opt | strip }}</option>
          {%- endfor -%}
        </select>
        <svg class="uc-buyhero__caret" viewBox="0 0 20 10" fill="none" aria-hidden="true">
          <path d="M2 2l8 6 8-6" stroke="#000" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <button type="submit" class="uc-buyhero__submit">{{ section.settings.button_label }}</button>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "UC Location Hero",
  "settings": [
