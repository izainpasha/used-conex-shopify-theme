{%- comment -%} Used Conex — "How to buy shipping container" step tabs + content card (dark section) {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-steps uc-font" id="uc-steps-{{ section.id }}">
  <div class="uc-wrap">
    <div class="uc-steps__head">
      <h2 class="uc-steps__title">{{ section.settings.heading }}</h2>
      <p class="uc-steps__intro">{{ section.settings.intro }}</p>
    </div>

    <div class="uc-steps__tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" class="uc-steps__tab{% if forloop.first %} is-active{% endif %}" data-step-tab="{{ forloop.index }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
          {{ block.settings.label }}
        </button>
        {%- unless forloop.last -%}<span class="uc-steps__tab-line" aria-hidden="true"></span>{%- endunless -%}
      {%- endfor -%}
    </div>

    <div class="uc-steps__panels">
      {%- for block in section.blocks -%}
        <div class="uc-steps__panel{% if forloop.first %} is-active{% endif %}" data-step-panel="{{ forloop.index }}" role="tabpanel">
          <h3 class="uc-steps__panel-title">{{ block.settings.panel_title }}</h3>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1360 | image_tag: class: 'uc-steps__panel-img', alt: block.settings.panel_title, loading: 'lazy' }}
          {%- elsif block.settings.fallback_image_url != blank -%}
            {%- render 'uc-img', src: block.settings.fallback_image_url, class: 'uc-steps__panel-img', alt: block.settings.panel_title, widths: '360,540,720,960,1360', sizes: '(min-width: 990px) 60vw, 100vw' -%}
          {%- endif -%}
          <div class="uc-steps__panel-body">{{ block.settings.panel_body }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function() {
  var section = document.getElementById('uc-steps-{{ section.id }}');
  if (!section) return;
  var tabs = section.querySelectorAll('[data-step-tab]');
  var panels = section.querySelectorAll('[data-step-panel]');
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var idx = tab.getAttribute('data-step-tab');
      tabs.forEach(function(t) { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
      panels.forEach(function(p) { p.classList.remove('is-active'); });
      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');
      var panel = section.querySelector('[data-step-panel="' + idx + '"]');
      if (panel) panel.classList.add('is-active');
    });
  });
})();
</script>

