{%- comment -%} Used Conex — Location page "Different Conex Types" dark band, 3 cards (Figma 274:824) {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-location-types uc-font">
  <div class="uc-wrap">
    <h2 class="uc-section-title uc-section-title--onDark">{{ section.settings.heading }}</h2>
    <p class="uc-location-types__intro">{{ section.settings.intro }}</p>

    <div class="uc-location-types__grid">
      {%- for block in section.blocks -%}
        <div class="uc-location-types__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 570 | image_tag: class: 'uc-location-types__img', alt: block.settings.title, loading: 'lazy' }}
          {%- elsif block.settings.fallback_image_url != blank -%}
            {%- render 'uc-img', src: block.settings.fallback_image_url, class: 'uc-location-types__img', alt: block.settings.title, widths: '280,420,570', sizes: '280px' -%}
          {%- endif -%}
          <h3 class="uc-location-types__title">{{ block.settings.title }}</h3>
          <p class="uc-location-types__text">{{ block.settings.text }}</p>
          <a class="uc-location-types__btn" href="{{ block.settings.link | default: '#' }}">{{ block.settings.button_label | default: 'Learn More' }}</a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

