{%- comment -%} Used Conex — Why Shipping Containers (3 icon features) {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

{%- assign icons = 'infinity,dollar,check' | split: ',' -%}

<section class="uc-section uc-font">
  <div class="uc-wrap">
    <h2 class="uc-section-title">{{ section.settings.heading }}</h2>
    <div class="uc-why__grid">
      {%- for block in section.blocks -%}
        <div class="uc-why__col" {{ block.shopify_attributes }}>
          <div class="uc-why__icon">
            {%- case block.settings.icon -%}
              {%- when 'dollar' -%}
                <svg viewBox="0 0 90 90" fill="none"><circle cx="45" cy="45" r="40" stroke="currentColor" stroke-width="5"/><path d="M45 22v46M55 33c-2-4-6-6-10-6-6 0-10 3-10 8s4 7 10 8 10 3 10 8-4 8-10 8-9-2-11-6" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>
              {%- when 'check' -%}
                <svg viewBox="0 0 90 90" fill="none"><rect x="8" y="8" width="74" height="74" rx="10" stroke="currentColor" stroke-width="5"/><path d="M26 46l14 14 26-30" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- else -%}
                <svg viewBox="0 0 90 90" fill="none"><path d="M27 30a15 15 0 100 30c8 0 12-6 18-15s10-15 18-15a15 15 0 110 30c-8 0-12-6-18-15S35 30 27 30z" stroke="currentColor" stroke-width="5"/></svg>
            {%- endcase -%}
          </div>
          <h3 class="uc-why__title">{{ block.settings.title }}</h3>
          <p class="uc-why__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
