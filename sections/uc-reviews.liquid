{%- comment -%}
  Used Conex — Customer review cards (Figma 245:2876).
  Each card: dark header with the story title, two bulleted lists, and a
  click-to-play YouTube video. The poster comes from YouTube's own thumbnail
  CDN so it is always a clean frame, and the iframe is only injected on click
  (six eager iframes would wreck page performance).
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-reviews uc-font">
  <div class="uc-wrap">
    {%- liquid
      # Keep the outline unbroken: cards are H2 under the page H1 unless the section has its own heading.
      assign uc_card_tag = 'h2'
      assign uc_sub_tag = 'h3'
      if section.settings.heading != blank
        assign uc_card_tag = 'h3'
        assign uc_sub_tag = 'h4'
      endif
    -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="uc-section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="uc-reviews__grid">
      {%- for block in section.blocks -%}
        {%- assign vid = block.settings.video_id | strip -%}
        <article class="uc-reviews__card" {{ block.shopify_attributes }}>
          <header class="uc-reviews__card-head">
            <{{ uc_card_tag }} class="uc-reviews__card-title">{{ block.settings.title }}</{{ uc_card_tag }}>
          </header>

          <div class="uc-reviews__card-body">
            <div class="uc-reviews__lists">
              {%- if block.settings.needed_title != blank -%}
                <{{ uc_sub_tag }} class="uc-reviews__subhead">{{ block.settings.needed_title }}</{{ uc_sub_tag }}>
                <div class="uc-reviews__list">{{ block.settings.needed_list }}</div>
              {%- endif -%}

              {%- if block.settings.delivered_title != blank -%}
                <{{ uc_sub_tag }} class="uc-reviews__subhead">{{ block.settings.delivered_title }}</{{ uc_sub_tag }}>
                <div class="uc-reviews__list">{{ block.settings.delivered_list }}</div>
              {%- endif -%}
            </div>

            <div class="uc-reviews__media">
              {%- if vid != blank -%}
                <button class="uc-reviews__video"
                        type="button"
                        data-yt="{{ vid }}"
                        aria-label="Play video: {{ block.settings.title | escape }}">
                  <img class="uc-reviews__poster"
                       src="https://i.ytimg.com/vi/{{ vid }}/oardefault.jpg"
                       onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ vid }}/maxresdefault.jpg'"
                       alt="{{ block.settings.title | escape }}" loading="lazy" width="1080" height="1920">
                  <span class="uc-reviews__play" aria-hidden="true">
                    <svg viewBox="0 0 68 48" width="68" height="48" focusable="false">
                      <path class="uc-reviews__play-bg" d="M66.52 7.74a8.57 8.57 0 0 0-6.02-6.06C55.2.24 34 .24 34 .24s-21.2 0-26.5 1.44a8.57 8.57 0 0 0-6.02 6.06A89.5 89.5 0 0 0 0 24a89.5 89.5 0 0 0 1.48 16.26 8.57 8.57 0 0 0 6.02 6.06C12.8 47.76 34 47.76 34 47.76s21.2 0 26.5-1.44a8.57 8.57 0 0 0 6.02-6.06A89.5 89.5 0 0 0 68 24a89.5 89.5 0 0 0-1.48-16.26z"/>
                      <path d="M27.2 34.4 45.6 24 27.2 13.6z" fill="#fff"/>
                    </svg>
                  </span>
                </button>
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 566 | image_tag: class: 'uc-reviews__poster', alt: block.settings.title, loading: 'lazy' }}
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>


