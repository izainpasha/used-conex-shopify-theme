{%- comment -%} Used Conex — Regions We Deliver {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-regions uc-font">
  <div class="uc-regions__bg-tint"></div>
  {%- if section.settings.background != blank -%}
    {{ section.settings.background | image_url: width: 1920 | image_tag: class: 'uc-regions__bg', alt: '', loading: 'lazy', widths: '900,1400,1920' }}
  {%- elsif section.settings.fallback_image_url != blank -%}
    {%- render 'uc-img', src: section.settings.fallback_image_url, class: 'uc-regions__bg' -%}
  {%- endif -%}
  <div class="uc-regions__inner">
    <div class="uc-regions__title">{{ section.settings.heading }}</div>
    <div class="uc-regions__grid">
      {%- for block in section.blocks -%}
        <div class="uc-regions__col" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <div class="uc-regions__name"><a href="{{ block.settings.link }}" style="color:inherit;text-decoration:none">{{ block.settings.title }}</a></div>
          {%- else -%}
            <div class="uc-regions__name">{{ block.settings.title }}</div>
          {%- endif -%}
          <ul>
            {%- if block.settings.menu != blank -%}
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- assign cities = block.settings.cities | newline_to_br | split: '<br />' -%}
              {%- for city in cities -%}
                {%- assign c = city | strip -%}
                {%- if c != blank -%}
                  {%- if c contains '::' -%}
                    {%- assign c_parts = c | split: '::' -%}
                    <li><a href="/pages/{{ c_parts | last | strip }}">{{ c_parts | first | strip }}</a></li>
                  {%- else -%}
                    <li><span>{{ c }}</span></li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

