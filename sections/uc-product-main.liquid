{%- comment -%}
  Used Conex — product detail, quote-only.
  No price, no quantity, no add-to-cart, no dynamic checkout. The single CTA
  is Request a Quote, carrying the container identity through to the CRM.
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-section uc-font uc-pdp"
  data-uc-pricing-target
  data-price-prefix="{{ section.settings.price_prefix }}"
  data-delivery-label="{{ section.settings.delivery_label | default: 'Includes delivery' }}"
>
  <div class="uc-wrap">
    <div class="uc-pdp__grid">

      <div class="uc-pdp__media">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 1100 | image_tag: class: 'uc-pdp__img', alt: product.title, loading: 'eager', widths: '400,600,900,1100' }}
        {%- endif -%}
        {%- if product.images.size > 1 -%}
          <div class="uc-pdp__thumbs">
            {%- for img in product.images offset: 1 limit: 4 -%}
              {{ img | image_url: width: 320 | image_tag: class: 'uc-pdp__thumb', alt: product.title, loading: 'lazy' }}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="uc-pdp__info" data-container-id="{{ product.metafields.custom.container_id.value }}">
        {%- assign grade = product.metafields.custom.type_category.value -%}
        {%- assign size_cat = product.metafields.custom.size_category.value -%}

        <h1 class="uc-pdp__title">{{ product.title }}</h1>

        <div class="uc-pdp__badges">
          {%- if size_cat != blank -%}<span class="uc-pdp__badge">{{ size_cat }}</span>{%- endif -%}
          {%- if grade != blank -%}<span class="uc-pdp__badge uc-pdp__badge--grade">{{ grade }}</span>{%- endif -%}
        </div>

        {%- if section.settings.blurb != blank -%}
          <p class="uc-pdp__blurb">{{ section.settings.blurb }}</p>
        {%- endif -%}

        {% render 'uc-zipbar',
          inline: true,
          label: section.settings.zip_label,
          placeholder: section.settings.zip_placeholder,
          button_label: section.settings.zip_button,
          live_pricing: section.settings.live_pricing,
          api_base: section.settings.api_base,
          api_email: section.settings.api_email
        %}

        <div class="uc-pdp__pricing" data-uc-pricing hidden>
          <span class="uc-pdp__price" data-uc-price></span>
          <span class="uc-pdp__delivery" data-uc-delivery></span>
        </div>
        <p class="uc-pdp__oos" data-uc-oos hidden>{{ section.settings.oos_message }}</p>
        <p class="uc-pdp__depot" data-uc-depot hidden></p>

        <a
          class="uc-pdp__cta"
          href="{{ section.settings.quote_url | default: '/pages/request-a-quote' }}"
          data-uc-quote-cta
                      data-quote-url="{{ section.settings.quote_url | default: '/pages/request-a-quote' }}"
                      data-size="{{ product.metafields.custom.size_category.value }}"
          data-product-title="{{ product.title | escape }}"
          data-product-handle="{{ product.handle }}"
          data-container-id="{{ product.metafields.custom.container_id.value }}"
          data-image="{{ product.featured_image | image_url: width: 160 }}"
        >{{ section.settings.quote_label }}</a>

        {%- if section.settings.phone != blank -%}
          <p class="uc-pdp__phone">
            {{ section.settings.phone_prefix }}
            <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}">{{ section.settings.phone }}</a>
          </p>
        {%- endif -%}

      </div>

    </div>
  </div>
</section>

