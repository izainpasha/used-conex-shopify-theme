{%- comment -%}
  Used Conex — Location page "Why Choose Used Conex?" (Figma 274:697):
  3 pills left + connector arrows + centered cube icon + connector arrows +
  3 pills right. Verified against the real Figma screenshot, not the raw
  code-context dump (which misidentified this as a photo+grid layout).
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-location-why uc-font">
  <div class="uc-wrap">
    <h2 class="uc-section-title">{{ section.settings.heading }}</h2>
    {%- assign mf_intro = page.metafields.location.why_us_intro.value -%}
    <p class="uc-location-why__intro">{{ mf_intro | default: section.settings.intro }}</p>

    {%- assign blocks = section.blocks -%}
    {%- assign left = blocks | slice: 0, 3 -%}
    {%- assign right = blocks | slice: 3, 3 -%}

    <div class="uc-location-why__layout">
      <div class="uc-location-why__col uc-location-why__col--left">
        {%- for block in left -%}
          <div class="uc-location-why__row" {{ block.shopify_attributes }}>
            <div class="uc-location-why__pill">
              {%- if block.settings.icon != blank -%}
                {{ block.settings.icon | image_url: width: 44 | image_tag: class: 'uc-location-why__pill-icon', alt: '', loading: 'lazy' }}
              {%- elsif block.settings.fallback_icon_url != blank -%}
                {%- render 'uc-img', src: block.settings.fallback_icon_url, class: 'uc-location-why__pill-icon', decorative: true, width: 24, height: 24, widths: '24,48', sizes: '24px' -%}
              {%- endif -%}
              <span>{{ block.settings.text }}</span>
            </div>
            <span class="uc-location-why__arrow uc-location-why__arrow--left" aria-hidden="true"></span>
          </div>
        {%- endfor -%}
      </div>

      <div class="uc-location-why__icon">
        {%- if section.settings.icon != blank -%}
          {{ section.settings.icon | image_url: width: 220 | image_tag: alt: '', loading: 'lazy' }}
        {%- elsif section.settings.fallback_icon_url != blank -%}
          {%- render 'uc-img', src: section.settings.fallback_icon_url, decorative: true, widths: '110,220', sizes: '110px' -%}
        {%- endif -%}
      </div>

      <div class="uc-location-why__col uc-location-why__col--right">
        {%- for block in right -%}
          <div class="uc-location-why__row" {{ block.shopify_attributes }}>
            <span class="uc-location-why__arrow uc-location-why__arrow--right" aria-hidden="true"></span>
            <div class="uc-location-why__pill">
              {%- if block.settings.icon != blank -%}
                {{ block.settings.icon | image_url: width: 44 | image_tag: class: 'uc-location-why__pill-icon', alt: '', loading: 'lazy' }}
              {%- elsif block.settings.fallback_icon_url != blank -%}
                {%- render 'uc-img', src: block.settings.fallback_icon_url, class: 'uc-location-why__pill-icon', decorative: true, width: 24, height: 24, widths: '24,48', sizes: '24px' -%}
              {%- endif -%}
              <span>{{ block.settings.text }}</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

