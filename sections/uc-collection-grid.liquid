{%- comment -%}
  Used Conex — collection page, list view.
  Layout and behaviour come from snippets/uc-listview.liquid.
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-font uc-lvsection uc-collection">
  <div class="uc-wrap">
    {%- paginate collection.products by 48 -%}
      {%- if collection.products.size > 0 -%}
        {%- capture sub -%}{%- if collection.description != blank -%}{{ collection.description }}{%- else -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}{%- endcapture -%}
        {% render 'uc-listview',
          products: collection.products,
          settings: section.settings,
          heading_tag: 'h1',
          heading: collection.title,
          subheading: sub,
          gate: false
        %}

        {%- if paginate.pages > 1 -%}
          <nav class="uc-collection__pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="uc-collection__page">{{ section.settings.prev_label }}</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="uc-collection__page">{{ part.title }}</a>
              {%- else -%}
                <span class="uc-collection__page uc-collection__page--current">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="uc-collection__page">{{ section.settings.next_label }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <h1 class="uc-lv__title">{{ collection.title }}</h1>
        <p class="uc-collection__empty">{{ section.settings.empty_message }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

