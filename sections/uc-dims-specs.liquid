{%- comment -%} Used Conex — Dimensions and sizes available at Used Conex (spec cards) {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-dims-specs uc-font">
  <div class="uc-wrap">
    <h2 class="uc-dims-specs__title">{{ section.settings.heading }}</h2>
    <div class="uc-dims-specs__grid">
      {%- for block in section.blocks -%}
        <div class="uc-dims-specs__card uc-dims-specs__card--{{ block.settings.color }}" {{ block.shopify_attributes }}>
          <h3 class="uc-dims-specs__card-title">{{ block.settings.title }}</h3>
          <div class="uc-dims-specs__table">
            <div class="uc-dims-specs__cell">
              <span class="uc-dims-specs__key">{{ block.settings.exterior_label }}</span>
              <span class="uc-dims-specs__val">{{ block.settings.exterior_value }}</span>
            </div>
            <div class="uc-dims-specs__cell">
              <span class="uc-dims-specs__key">{{ block.settings.tare_label }}</span>
              <span class="uc-dims-specs__val">{{ block.settings.tare_value }}</span>
            </div>
            <div class="uc-dims-specs__cell">
              <span class="uc-dims-specs__key">{{ block.settings.interior_label }}</span>
              <span class="uc-dims-specs__val">{{ block.settings.interior_value }}</span>
            </div>
            <div class="uc-dims-specs__cell">
              <span class="uc-dims-specs__key">{{ block.settings.payload_label }}</span>
              <span class="uc-dims-specs__val">{{ block.settings.payload_value }}</span>
            </div>
          </div>
          <div class="uc-dims-specs__desc">{{ block.settings.description }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

