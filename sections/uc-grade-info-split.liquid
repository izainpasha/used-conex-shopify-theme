{%- render 'uc-section-style', section: section -%}
<section class="uc-grade-info uc-section uc-font">
  <div class="uc-wrap uc-grade-info__layout">
    <div class="uc-grade-info__content">
      <h2 class="uc-grade-info__title">{{ section.settings.heading }}</h2>
      <div class="uc-grade-info__body">{{ section.settings.body }}</div>
      {% if section.settings.subheading != blank %}<h3 class="uc-grade-info__subheading">{{ section.settings.subheading }}</h3>{% endif %}
      {% if section.settings.supporting_text != blank %}<div class="uc-grade-info__body">{{ section.settings.supporting_text }}</div>{% endif %}
    </div>
    <div class="uc-grade-info__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 858 | image_tag: alt: section.settings.image_alt, loading: 'lazy' }}
      {% elsif section.settings.fallback_image_url != blank %}
        {%- render 'uc-img', src: section.settings.fallback_image_url, alt_override: section.settings.image_alt, width: 429, height: 477, widths: '360,429,640,858', sizes: '(min-width: 990px) 50vw, 100vw' -%}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "UC Grade Information",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What is a Wind and Watertight Container?"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "supporting_text",
      "label": "Supporting text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "fallback_image_url",
      "label": "Fallback image URL"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Wind and watertight shipping container"
    },
    {
      "type": "header",
      "content": "Section style — colors"
    },
    {
      "type": "paragraph",
      "content": "Everything under Section style is optional. Leave a field empty to keep the design as built."
    },
    {
      "type": "color_background",
      "id": "st_bg",
      "label": "Background (color or gradient)"
    },
    {
      "type": "image_picker",
      "id": "st_bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "st_overlay",
      "label": "Background image darkening",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "st_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "st_text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Section style — typography"
    },
    {
      "type": "checkbox",
      "id": "st_custom_fonts",
      "label": "Use custom fonts in this section",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "st_heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "st_body_font",
      "label": "Text and button font",
      "default": "assistant_n4"
    },
    {
      "type": "number",
      "id": "st_heading_size",
      "label": "Main heading size (px, desktop)"
    },
    {
      "type": "number",
      "id": "st_subheading_size",
      "label": "Sub heading size (px, desktop)"
    },
    {
      "type": "select",
      "id": "st_heading_weight",
      "label": "Heading weight",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ]
    },
    {
      "type": "select",
      "id": "st_heading_case",
      "label": "Heading letter case",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "none",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
          "label": "Capitalize Each Word"
