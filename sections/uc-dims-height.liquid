{%- comment -%} Used Conex — How tall is a CONEX box (height diagram + note) {%- endcomment -%}{%- render 'uc-section-style', section: section -%}

{%- assign img_20 = section.settings.image_20 -%}
{%- assign img_40 = section.settings.image_40 -%}
{%- assign img_person = section.settings.image_person -%}

<section class="uc-dims-height uc-font">
  <div class="uc-wrap">
    <h2 class="uc-dims-height__title">{{ section.settings.heading }}</h2>
    <p class="uc-dims-height__intro">{{ section.settings.intro }}</p>

    <div class="uc-dims-height__panel">
      <div class="uc-dims-height__stage">
        <figure class="uc-dims-height__unit">
          <figcaption class="uc-dims-height__unit-label">{{ section.settings.label_20 }}</figcaption>
          {%- if img_20 != blank -%}
            {{ img_20 | image_url: width: 684 | image_tag: class: 'uc-dims-height__art', alt: section.settings.label_20, loading: 'lazy' }}
          {%- else -%}
            {%- render 'uc-img', src: section.settings.fallback_20_url, class: 'uc-dims-height__art', alt: section.settings.label_20, width: 342, height: 470, widths: '342,513,684', sizes: '(min-width: 750px) 342px, 45vw' -%}
          {%- endif -%}
        </figure>

        <div class="uc-dims-height__rulers" aria-hidden="true">
          <span class="uc-dims-height__ruler">
            <span class="uc-dims-height__ruler-text">{{ section.settings.height_20 }}</span>
          </span>
          <span class="uc-dims-height__ruler">
            <span class="uc-dims-height__ruler-text">{{ section.settings.height_40 }}</span>
          </span>
        </div>

        <figure class="uc-dims-height__unit">
          <figcaption class="uc-dims-height__unit-label">{{ section.settings.label_40 }}</figcaption>
          {%- if img_40 != blank -%}
            {{ img_40 | image_url: width: 684 | image_tag: class: 'uc-dims-height__art', alt: section.settings.label_40, loading: 'lazy' }}
          {%- else -%}
            {%- render 'uc-img', src: section.settings.fallback_40_url, class: 'uc-dims-height__art', alt: section.settings.label_40, width: 342, height: 470, widths: '342,513,684', sizes: '(min-width: 750px) 342px, 45vw' -%}
          {%- endif -%}
        </figure>

        <div class="uc-dims-height__aside">
          {%- if img_person != blank -%}
            {{ img_person | image_url: width: 916 | image_tag: class: 'uc-dims-height__person', alt: '', loading: 'lazy' }}
          {%- else -%}
            {%- render 'uc-img', src: section.settings.fallback_person_url, class: 'uc-dims-height__person', decorative: true, width: 458, height: 410, widths: '458,687,916', sizes: '(min-width: 750px) 458px, 50vw' -%}
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.note_text != blank -%}
        <div class="uc-dims-height__note">
          <strong>{{ section.settings.note_label }}</strong>
          <span>{{ section.settings.note_text }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UC Dims Height",
  "settings": [
