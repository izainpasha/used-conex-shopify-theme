{%- comment -%} Used Conex — About Us intro (copy left, overlapping images right) {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-about-intro uc-font">
  <div class="uc-wrap">
    <div class="uc-about-intro__inner">
      <div class="uc-about-intro__text">{{ section.settings.body }}</div>

      <div class="uc-about-intro__media">
        {%- if section.settings.image_large != blank -%}
          {%- assign uc_alt = section.settings.image_large.alt | default: section.settings.heading | default: section.settings.title | default: 'Used Conex shipping containers' -%}{{ section.settings.image_large | image_url: width: 1176 | image_tag: class: 'uc-about-intro__img uc-about-intro__img--lg', alt: uc_alt, loading: 'lazy' }}
        {%- elsif section.settings.fallback_large_url != blank -%}
          {%- render 'uc-img', src: section.settings.fallback_large_url, class: 'uc-about-intro__img uc-about-intro__img--lg', alt: 'Used Conex shipping containers', width: 588, height: 609, widths: '360,588,900,1176', sizes: '(min-width: 990px) 40vw, 100vw' -%}
        {%- endif -%}

        {%- if section.settings.image_small != blank -%}
          {%- assign uc_alt = section.settings.image_small.alt | default: section.settings.heading | default: section.settings.title | default: 'Used Conex shipping container delivery' -%}{{ section.settings.image_small | image_url: width: 562 | image_tag: class: 'uc-about-intro__img uc-about-intro__img--sm', alt: uc_alt, loading: 'lazy' }}
        {%- elsif section.settings.fallback_small_url != blank -%}
          {%- render 'uc-img', src: section.settings.fallback_small_url, class: 'uc-about-intro__img uc-about-intro__img--sm', alt: 'Used Conex shipping container delivery', width: 281, height: 469, widths: '281,420,562', sizes: '(min-width: 990px) 20vw, 50vw' -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UC About Intro",
  "settings": [
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>We are a leading retail company supplying and delivering secondhand shipping containers throughout the United States.</p><p>We work directly with the shipping lines and shipping container manufacturers who bring thousands of containers into the country regularly.</p><p>We buy new and used shipping containers in bulk, and we store them at some of the biggest depots around the country. That is how we can provide the best quality shipping containers at the lowest prices in the industry.</p><p>Our team works hard to provide inventory near your city so everyone can access the best deals.</p><p>We work with owner-operator trucking companies that not only have the best delivery rates but also know your local area very well and have years of experience delivering shipping containers.</p><p>All our containers have been inspected by certified personnel at the depot, and our drivers inspect the container before pick-up to ensure that the container matches the condition mentioned on Used Conex's inspection sheet they have on hand.</p>"
    },
    {
      "type": "header",
