{%- comment -%}
  Used Conex — Service page body image.
  Reusable across every service page (Financing, Modifications, Moving, …):
  the image is a per-page setting, so one section serves them all.
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

{%- assign img = section.settings.image -%}
{%- assign alt = section.settings.image_alt | default: page.title -%}

<section class="uc-service-image uc-font">
  <div class="uc-wrap">
    {%- if img != blank -%}
      {{ img | image_url: width: 1440 | image_tag:
           class: 'uc-service-image__img',
           alt: alt,
           loading: 'lazy',
           widths: '480,750,990,1200,1440' }}
    {%- elsif section.settings.fallback_image_url != blank -%}
      {%- render 'uc-img', src: section.settings.fallback_image_url, class: 'uc-service-image__img', alt_override: section.settings.image_alt, alt: page.title, width: 1440, height: 1851, widths: '480,750,990,1200,1440', sizes: '(min-width: 1440px) 1200px, 100vw' -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "UC Service Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Body image",
