{%- comment -%}
  Used Conex — Location page "Customer Reviews" dark band (Figma 274:901).
  Verified against the real Figma screenshot: this is the SAME two-story
  bullet-list card format as the main Reviews page (sections/uc-reviews.liquid),
  in a 2x2 grid — not the plain-text-testimonial format WordPress's raw HTML
  suggested. Layout matches Figma; per-city copy is instance data.
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-location-reviews uc-font">
  <div class="uc-wrap">
    <h2 class="uc-section-title uc-section-title--onDark">{{ section.settings.heading }}</h2>
    {%- assign mf_intro = page.metafields.location.reviews_intro_html.value -%}
    <div class="uc-location-reviews__intro">{{ mf_intro | default: section.settings.intro }}</div>

    <div class="uc-reviews__grid uc-location-reviews__grid">
      {%- for block in section.blocks -%}
        {%- assign vid = block.settings.video_id | strip -%}
        <article class="uc-reviews__card" {{ block.shopify_attributes }}>
          <header class="uc-reviews__card-head">
            <h3 class="uc-reviews__card-title">{{ block.settings.title }}</h3>
          </header>
          <div class="uc-reviews__card-body">
            <div class="uc-reviews__lists">
              {%- if block.settings.needed_title != blank -%}
                <h3 class="uc-reviews__subhead">{{ block.settings.needed_title }}</h3>
                <div class="uc-reviews__list">{{ block.settings.needed_list }}</div>
              {%- endif -%}
              {%- if block.settings.delivered_title != blank -%}
                <h3 class="uc-reviews__subhead">{{ block.settings.delivered_title }}</h3>
                <div class="uc-reviews__list">{{ block.settings.delivered_list }}</div>
              {%- endif -%}
            </div>
            <div class="uc-reviews__media">
              {%- if vid != blank -%}
                <button class="uc-reviews__video" type="button" data-yt="{{ vid }}" aria-label="Play video: {{ block.settings.title | escape }}">
                  <img class="uc-reviews__poster" src="https://i.ytimg.com/vi/{{ vid }}/oardefault.jpg" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ vid }}/maxresdefault.jpg'" alt="{{ block.settings.title | escape }}" loading="lazy" width="1080" height="1920">
                  <span class="uc-reviews__play" aria-hidden="true">
                    <svg viewBox="0 0 68 48" width="68" height="48" focusable="false">
                      <path class="uc-reviews__play-bg" d="M66.52 7.74a8.57 8.57 0 0 0-6.02-6.06C55.2.24 34 .24 34 .24s-21.2 0-26.5 1.44a8.57 8.57 0 0 0-6.02 6.06A89.5 89.5 0 0 0 0 24a89.5 89.5 0 0 0 1.48 16.26 8.57 8.57 0 0 0 6.02 6.06C12.8 47.76 34 47.76 34 47.76s21.2 0 26.5-1.44a8.57 8.57 0 0 0 6.02-6.06A89.5 89.5 0 0 0 68 24a89.5 89.5 0 0 0-1.48-16.26z"/>
                      <path d="M27.2 34.4 45.6 24 27.2 13.6z" fill="#fff"/>
                    </svg>
                  </span>
                </button>
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 566 | image_tag: class: 'uc-reviews__poster', alt: block.settings.title, loading: 'lazy' }}
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root) return;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('.uc-reviews__video');
      if (!btn) return;
      var id = btn.getAttribute('data-yt');
      if (!id) return;
      var frame = document.createElement('iframe');
      frame.className = 'uc-reviews__iframe';
      frame.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0&playsinline=1';
      frame.title = btn.getAttribute('aria-label') || 'Customer review video';
      frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.setAttribute('loading', 'lazy');
      btn.replaceWith(frame);
    });
  })();
</script>

