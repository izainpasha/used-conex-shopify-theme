{%- comment -%}
  Used Conex — ZIP search results ("Containers Available Near You"), list view.

  Hero ZIP forms across the site submit here with ?zipcode=&isDelivery=.
  Rows stay hidden until a valid US ZIP is entered (gate: true); the gate is
  presentational only. Layout and behaviour come from snippets/uc-listview.liquid.
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-font uc-lvsection">
  <div class="uc-wrap">
    {%- capture sub -%}<p>{{ section.settings.subheading }}</p>{%- endcapture -%}
    {% render 'uc-listview',
      products: collections.all.products,
      settings: section.settings,
      heading_tag: 'h2',
      heading: section.settings.heading,
      subheading: sub,
      gate: true
    %}
  </div>
</section>

