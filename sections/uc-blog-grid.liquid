{%- comment -%}
  Used Conex — Blog page post grid (Figma 245:3239).
  Reuses the exact uc-news__card markup/CSS already built for the homepage
  "Container News" cards, but paginated across the full blog instead of
  capped at 3, with a category filter.
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

{%- assign per_page = section.settings.posts_per_page -%}

<section class="uc-section uc-font">
  <div class="uc-wrap">
    <div class="uc-blog-grid__head">
      <h2 class="uc-blog-grid__title">{{ section.settings.heading }}</h2>
      {%- if blog.all_tags.size > 0 -%}
        <div class="uc-blog-grid__filter">
          <select id="uc-blog-filter-{{ section.id }}" onchange="if(this.value){window.location.href=this.value}">
            <option value="{{ blog.url }}" {% unless current_tags %}selected{% endunless %}>{{ section.settings.all_label }}</option>
            {%- for tag in blog.all_tags -%}
              <option value="{{ blog.url }}/tagged/{{ tag | handleize }}" {% if current_tags contains tag %}selected{% endif %}>{{ tag }}</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>

    {%- paginate blog.articles by per_page -%}
      <div class="uc-news__grid">
        {%- for article in blog.articles -%}
          <article class="uc-news__card">
            {%- if article.image -%}
              {{ article.image | image_url: width: 920 | image_tag: class: 'uc-news__card-bg', alt: article.title, loading: 'lazy' }}
            {%- elsif section.settings.fallback_image_url != blank -%}
              {%- render 'uc-img', src: section.settings.fallback_image_url, class: 'uc-news__card-bg', decorative: true, widths: '360,540,720,920', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw' -%}
            {%- endif -%}
            <span class="uc-news__tag">{{ section.settings.tag_label }}</span>
            <span class="uc-news__likes" aria-hidden="true">
              <svg viewBox="0 0 18.8333 16.351" fill="none"><path d="M5.47917 0.666667C2.82135 0.666667 0.666667 2.82136 0.666667 5.47917C0.666667 10.2917 6.35417 14.6667 9.41667 15.6843C12.4792 14.6667 18.1667 10.2917 18.1667 5.47917C18.1667 2.82136 16.012 0.666667 13.3542 0.666667C11.7267 0.666667 10.2873 1.47473 9.41667 2.71154C8.97283 2.07952 8.38327 1.56372 7.69789 1.20778C7.0125 0.851837 6.25146 0.666231 5.47917 0.666667Z" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/></svg>
              0
            </span>
            <h3 class="uc-news__title">{{ article.title }}</h3>
            <div class="uc-news__rule"></div>
            <p class="uc-news__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
            <a class="uc-news__more" href="{{ article.url }}">{{ section.settings.more_label }}</a>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="uc-blog-grid__pagination" role="navigation" aria-label="Pagination">
          <ul class="uc-blog-grid__pagination-list">
            {%- if paginate.previous -%}
              <li>
                <a href="{{ paginate.previous.url }}" class="uc-blog-grid__pagination-item uc-blog-grid__pagination-item--arrow" aria-label="Previous page">
                  <svg viewBox="0 0 13 7" fill="none" aria-hidden="true"><path d="M13 3.5H2M5 1 2 3.5 5 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </li>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="uc-blog-grid__pagination-item" aria-label="Page {{ part.title }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="uc-blog-grid__pagination-item uc-blog-grid__pagination-item--current" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span class="uc-blog-grid__pagination-item uc-blog-grid__pagination-item--gap">{{ part.title }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if paginate.next -%}
              <li>
                <a href="{{ paginate.next.url }}" class="uc-blog-grid__pagination-item uc-blog-grid__pagination-item--arrow" aria-label="Next page">
                  <svg viewBox="0 0 13 7" fill="none" aria-hidden="true"><path d="M0 3.5h11M8 1l3 2.5L8 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

