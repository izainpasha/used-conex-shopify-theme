{%- comment -%} Used Conex — What is the size of a standard storage container (20ft/40ft comparison) {%- endcomment -%}{%- render 'uc-section-style', section: section -%}


<section class="uc-dims-size uc-font">
  <div class="uc-wrap">
    <div class="uc-dims-size__head">
      <h2 class="uc-dims-size__title">{{ section.settings.heading }}</h2>
      <p class="uc-dims-size__intro">{{ section.settings.intro }}</p>
    </div>
  </div>

  <div class="uc-dims-size__band">
    <div class="uc-dims-size__row">
      <div class="uc-dims-size__col">
        <span class="uc-dims-size__label">{{ section.settings.left_label }}</span>
        {%- if section.settings.left_image != blank -%}
          {{ section.settings.left_image | image_url: width: 1000 | image_tag: class: 'uc-dims-size__img', alt: section.settings.left_label, loading: 'lazy' }}
        {%- elsif section.settings.left_fallback_image_url != blank -%}
          {%- render 'uc-img', src: section.settings.left_fallback_image_url, class: 'uc-dims-size__img', alt: section.settings.left_label, widths: '360,540,720,1000', sizes: '(min-width: 990px) 50vw, 100vw' -%}
        {%- endif -%}
      </div>
      <div class="uc-dims-size__mid">
        {%- render 'uc-img', src: section.settings.arrow_image_url, class: 'uc-dims-size__arrow', decorative: true, width: 304, height: 8 -%}
        <span class="uc-dims-size__mid-label">{{ section.settings.mid_label }}</span>
        {%- render 'uc-img', src: section.settings.arrow_image_url, class: 'uc-dims-size__arrow', decorative: true, width: 304, height: 8 -%}
      </div>
      <div class="uc-dims-size__col uc-dims-size__col--right">
        <span class="uc-dims-size__label">{{ section.settings.right_label }}</span>
        {%- if section.settings.right_image != blank -%}
          {{ section.settings.right_image | image_url: width: 1200 | image_tag: class: 'uc-dims-size__img', alt: section.settings.right_label, loading: 'lazy' }}
        {%- elsif section.settings.right_fallback_image_url != blank -%}
          {%- render 'uc-img', src: section.settings.right_fallback_image_url, class: 'uc-dims-size__img', alt: section.settings.right_label, widths: '360,540,720,960,1200', sizes: '(min-width: 990px) 50vw, 100vw' -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="uc-wrap">
    <div class="uc-dims-size__text">{{ section.settings.body }}</div>
  </div>
</section>

{% schema %}
{
  "name": "UC Dims Standard Size",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What is the size of a standard storage container?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Shipping container dimensions are generally standardized for cargo and international shipping, but there are a few things to know within those sizes before deciding what you need. The purpose for your rental or purchase matters, as do your needs for that shipping container. Standard conex boxes typically come in:"
    },
    {
      "type": "text",
      "id": "left_label",
      "label": "Left label",
      "default": "20 Foot"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left container image"
    },
    {
      "type": "text",
      "id": "left_fallback_image_url",
      "label": "Fallback left image URL",
      "info": "Used only if no image uploaded",
      "default": "https://cdn.shopify.com/s/files/1/1029/2284/6530/files/uc-dims-container-20ft.png"
    },
    {
      "type": "text",
      "id": "mid_label",
      "label": "Middle label",
      "default": "8 Feet Wide"
    },
    {
      "type": "text",
      "id": "arrow_image_url",
      "label": "Width arrow image URL",
      "default": "https://cdn.shopify.com/s/files/1/1029/2284/6530/files/uc-dims-arrow.svg"
    },
    {
      "type": "text",
      "id": "right_label",
      "label": "Right label",
      "default": "40 Foot"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right container image"
    },
    {
      "type": "text",
      "id": "right_fallback_image_url",
      "label": "Fallback right image URL",
      "info": "Used only if no image uploaded",
      "default": "https://cdn.shopify.com/s/files/1/1029/2284/6530/files/uc-dims-container-40ft.png"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>The standard sizes of ISO shipping containers are also 20 feet or 40 feet long, and each container is 8 feet wide. No matter the length, the width remains the same. That’s because these containers are most often used for cargo transport. A variety of sizes would lead to issues loading, stacking, and unloading, which could lead to inefficiencies in the process.</p><p>With standardized sizes, there’s no need to estimate size and space needed for a cargo transport and the shipping process becomes less complex to manage.</p>"
    },
    {
      "type": "header",
      "content": "Section style — colors"
    },
    {
      "type": "paragraph",
      "content": "Everything under Section style is optional. Leave a field empty to keep the design as built."
