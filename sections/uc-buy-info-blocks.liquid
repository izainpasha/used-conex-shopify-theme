{%- comment -%} Used Conex — Stacked text info blocks (heading + paragraph/richtext), e.g. "What Are Shipping Containers?" {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-info uc-font">
  <div class="uc-wrap">
    {%- for block in section.blocks -%}
      <div class="uc-info__block" {{ block.shopify_attributes }}>
        <h2 class="uc-info__title">{{ block.settings.heading }}</h2>
        <div class="uc-info__body">{{ block.settings.body }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "UC Buy Info Blocks",
  "settings": [
    {
      "type": "header",
      "content": "Section style — colors"
    },
    {
      "type": "paragraph",
      "content": "Everything under Section style is optional. Leave a field empty to keep the design as built."
