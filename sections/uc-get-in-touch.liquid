{%- comment -%} Used Conex — Get In Touch (3 info cards) {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-section uc-font">
  <div class="uc-wrap">
    <h2 class="uc-section-title">{{ section.settings.heading }}</h2>
    <div class="uc-touch__grid">
      {%- for block in section.blocks -%}
        <div class="uc-touch__card" {{ block.shopify_attributes }}>
          {%- if block.settings.card_bg != blank -%}
            {%- render 'uc-img', image: block.settings.card_bg, class: 'uc-touch__card-bg', decorative: true, widths: '360,540,720,920', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw' -%}
          {%- elsif block.settings.fallback_image_url != blank -%}
            {%- render 'uc-img', src: block.settings.fallback_image_url, class: 'uc-touch__card-bg', decorative: true, widths: '360,540,720,920', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw' -%}
          {%- endif -%}
          <h3 class="uc-touch__title">{{ block.settings.title }}</h3>
          <div class="uc-touch__rule"></div>
          <div class="uc-touch__body">{{ block.settings.body }}</div>
          <span class="uc-touch__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'contact' -%}
                <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="3" width="15" height="18" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M4 8H2M4 12H2M4 16H2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="11" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M7 17c.7-2 2.2-3 4-3s3.3 1 4 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              {%- when 'clock' -%}
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 20V8l7-4 7 4v12M9 20v-5h6v5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 10h1M12 10h1M8 13h1M12 13h1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            {%- endcase -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

