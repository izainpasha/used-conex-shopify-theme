{%- comment -%} Used Conex — "Best shipping containers to buy" (3 colored cards: Condition / Ideal for) {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-section uc-font">
  <div class="uc-wrap">
    <h2 class="uc-section-title">{{ section.settings.heading }}</h2>
    <p class="uc-cardsub">{{ section.settings.subheading }}</p>
    <div class="uc-buycards__grid">
      {%- for block in section.blocks -%}
        <div class="uc-buycards__card uc-buycards__card--{{ block.settings.style }}" {{ block.shopify_attributes }}>
          <h3 class="uc-buycards__title">{{ block.settings.title }}</h3>
          <h4 class="uc-buycards__label">{{ block.settings.condition_label }}</h4>
          <ul class="uc-buycards__list">
            {%- assign conditions = block.settings.condition_items | newline_to_br | split: '<br />' -%}
            {%- for item in conditions -%}
              {%- assign c = item | strip -%}
              {%- if c != blank -%}<li>{{ c }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          <h4 class="uc-buycards__label">{{ block.settings.ideal_label }}</h4>
          <ul class="uc-buycards__list">
            {%- assign ideals = block.settings.ideal_items | newline_to_br | split: '<br />' -%}
            {%- for item in ideals -%}
              {%- assign i = item | strip -%}
              {%- if i != blank -%}<li>{{ i }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

