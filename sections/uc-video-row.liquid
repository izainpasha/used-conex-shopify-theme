{%- comment -%} Used Conex — Video / media row (2 or 3 up) {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-section uc-font">
  <div class="uc-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="uc-section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="uc-media-row uc-media-row--{{ section.blocks.size | at_most: 3 }}">
      {%- for block in section.blocks -%}
        <div class="uc-media{% if section.blocks.size > 2 %} uc-media--sm{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.youtube_id != blank -%}
            {%- comment -%}
              Poster + click-to-play (handled in uc-storefront.js). An embedded
              player costs ~1MB of YouTube JS per video before anyone presses play.
            {%- endcomment -%}
            {%- assign vid = block.settings.youtube_id | strip -%}
            <button class="uc-media__video" type="button" data-yt="{{ vid }}" aria-label="Play video: {{ block.settings.title | default: 'Used Conex video' | escape }}">
              <img
                src="https://i.ytimg.com/vi/{{ vid }}/maxresdefault.jpg"
                srcset="https://i.ytimg.com/vi/{{ vid }}/sddefault.jpg 640w, https://i.ytimg.com/vi/{{ vid }}/maxresdefault.jpg 1280w"
                sizes="{% if section.blocks.size > 2 %}(min-width: 990px) 33vw{% else %}(min-width: 990px) 50vw{% endif %}, 100vw"
                alt="{{ block.settings.title | escape }}"
                width="1280" height="720" loading="lazy" decoding="async">
              <span class="uc-media__play" aria-hidden="true">
                <svg viewBox="0 0 68 48"><path d="M66.5 7.5a8 8 0 00-5.6-5.7C56 .5 34 .5 34 .5S12 .5 7.1 1.8A8 8 0 001.5 7.5C.2 12.4.2 24 .2 24s0 11.6 1.3 16.5a8 8 0 005.6 5.7C12 47.5 34 47.5 34 47.5s22 0 26.9-1.3a8 8 0 005.6-5.7C67.8 35.6 67.8 24 67.8 24s0-11.6-1.3-16.5z" fill="#f00"/><path d="M27 34l18-10-18-10z" fill="#fff"/></svg>
              </span>
            </button>
          {%- else -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1420 | image_tag: alt: block.settings.title, loading: 'lazy' }}
            {%- elsif block.settings.fallback_image_url != blank -%}
              {%- render 'uc-img', src: block.settings.fallback_image_url, alt: block.settings.title, widths: '360,540,710,1065,1420', sizes: '(min-width: 990px) 50vw, 100vw' -%}
            {%- endif -%}
            <span class="uc-media__play" aria-hidden="true">
              <svg viewBox="0 0 68 48"><path d="M66.5 7.5a8 8 0 00-5.6-5.7C56 .5 34 .5 34 .5S12 .5 7.1 1.8A8 8 0 001.5 7.5C.2 12.4.2 24 .2 24s0 11.6 1.3 16.5a8 8 0 005.6 5.7C12 47.5 34 47.5 34 47.5s22 0 26.9-1.3a8 8 0 005.6-5.7C67.8 35.6 67.8 24 67.8 24s0-11.6-1.3-16.5z" fill="#f00"/><path d="M27 34l18-10-18-10z" fill="#fff"/></svg>
            </span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

