{%- comment -%}
  Used Conex — checkout (quote request) page.

  Form on the left (contact + delivery address), order summary on the right
  (containers selected, delivered price, tax when there is any, total).
  The ZIP comes prefilled from the one the visitor already searched; changing
  it re-prices the order.

  "Continue to Payment" creates the customer and a quote-flagged order in the
  CRM, then hands off to the CRM's own hosted payment page — no card details
  are collected on this site. "Save My Quote for Later" sends the same quote
  but stays here and shows the reference.

  All behaviour lives in uc-quote.js and uc-storefront.js.
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-font uc-checkout"
  data-uc-quote-page
  data-api-base="{{ section.settings.api_base | default: 'https://api.usedconex.com/client/v1' }}"
  data-price-prefix="{{ section.settings.price_prefix }}"
  data-delivery-label="{{ section.settings.delivery_label | default: 'Includes delivery' }}"
  data-msg-invalid-zip="{{ section.settings.invalid_zip | escape }}"
  data-msg-required="{{ section.settings.required_message | escape }}"
  data-msg-email="{{ section.settings.email_message | escape }}"
  data-msg-sending="{{ section.settings.sending_message | escape }}"
  data-msg-redirecting="{{ section.settings.redirecting_message | escape }}"
  data-msg-empty="{{ section.settings.empty_message | escape }}"
  data-item-note="{{ section.settings.item_note | escape }}"
>
  <div class="uc-wrap">

    <div class="uc-checkout__top">
      <a class="uc-checkout__back" href="{{ section.settings.browse_url | default: '/collections/all' }}">
        {%- render 'uc-icon', name: 'arrow-left' -%}{{ section.settings.back_label }}
      </a>
      <ol class="uc-checkout__steps" aria-label="Checkout progress">
        <li class="is-done"><span class="uc-checkout__stepdot">{%- render 'uc-icon', name: 'check' -%}</span><span>{{ section.settings.step1_label }}</span></li>
        <li class="is-current" aria-current="step"><span class="uc-checkout__stepdot">2</span><span>{{ section.settings.step2_label }}</span></li>
        <li><span class="uc-checkout__stepdot">3</span><span>{{ section.settings.step3_label }}</span></li>
      </ol>
      <div class="uc-checkout__trusted">
        {%- render 'uc-icon', name: 'shield-check' -%}
        <div><strong>{{ section.settings.trusted_heading }}</strong><span>{{ section.settings.trusted_body }}</span></div>
      </div>
    </div>

    <div class="uc-checkout__grid" data-uc-quote-main>

      <form class="uc-checkout__card uc-checkout__form" data-uc-quote-form novalidate>
        <div class="uc-checkout__head">
          <div>
            <h1 class="uc-checkout__title">{{ section.settings.heading }}</h1>
            <p class="uc-checkout__sub">{{ section.settings.subheading }}</p>
          </div>
          <div class="uc-checkout__fast">
            {%- render 'uc-icon', name: 'truck' -%}
            <div><strong>{{ section.settings.fast_heading }}</strong><span>{{ section.settings.fast_body }}</span></div>
          </div>
        </div>

        <div class="uc-checkout__step">
          <span class="uc-checkout__num">1</span>
          <div><h2>{{ section.settings.contact_heading }}</h2><p>{{ section.settings.contact_sub }}</p></div>
        </div>

        <div class="uc-checkout__row2">
          <label class="uc-checkout__field">
            <span class="uc-checkout__label">{{ section.settings.first_label }} <em>*</em></span>
            <span class="uc-checkout__control">{%- render 'uc-icon', name: 'user' -%}<input type="text" name="firstName" autocomplete="given-name" placeholder="{{ section.settings.first_ph | escape }}" required></span>
          </label>
          <label class="uc-checkout__field">
            <span class="uc-checkout__label">{{ section.settings.last_label }} <em>*</em></span>
            <span class="uc-checkout__control">{%- render 'uc-icon', name: 'user' -%}<input type="text" name="lastName" autocomplete="family-name" placeholder="{{ section.settings.last_ph | escape }}" required></span>
          </label>
        </div>
        <div class="uc-checkout__row2">
          <label class="uc-checkout__field">
            <span class="uc-checkout__label">{{ section.settings.email_label }} <em>*</em></span>
            <span class="uc-checkout__control">{%- render 'uc-icon', name: 'mail' -%}<input type="email" name="email" autocomplete="email" placeholder="{{ section.settings.email_ph | escape }}" required></span>
          </label>
          <label class="uc-checkout__field">
            <span class="uc-checkout__label">{{ section.settings.phone_label }} <em>*</em></span>
            <span class="uc-checkout__control">{%- render 'uc-icon', name: 'phone' -%}<input type="tel" name="phone" autocomplete="tel" placeholder="{{ section.settings.phone_ph | escape }}" required></span>
          </label>
        </div>

        <hr class="uc-checkout__rule">

        <div class="uc-checkout__step">
          <span class="uc-checkout__num">2</span>
          <div><h2>{{ section.settings.address_heading }}</h2><p>{{ section.settings.address_sub }}</p></div>
        </div>

        <label class="uc-checkout__field">
          <span class="uc-checkout__label">{{ section.settings.street_label }} <em>*</em></span>
          <span class="uc-checkout__control">{%- render 'uc-icon', name: 'map-pin' -%}<input type="text" name="address" autocomplete="street-address" placeholder="{{ section.settings.street_ph | escape }}" required></span>
        </label>
        <div class="uc-checkout__row2">
          <label class="uc-checkout__field">
            <span class="uc-checkout__label">{{ section.settings.city_label }} <em>*</em></span>
            <span class="uc-checkout__control">{%- render 'uc-icon', name: 'map-pin' -%}<input type="text" name="city" autocomplete="address-level2" placeholder="{{ section.settings.city_ph | escape }}" required></span>
          </label>
          <label class="uc-checkout__field">
            <span class="uc-checkout__label">{{ section.settings.state_label }} <em>*</em></span>
            <span class="uc-checkout__control uc-checkout__control--select">
              <select name="state" autocomplete="address-level1" required data-uc-quote-state>
                <option value="">{{ section.settings.state_ph }}</option>
              </select>
              {%- render 'uc-icon', name: 'chevron-down' -%}
            </span>
          </label>
        </div>
        <label class="uc-checkout__field">
          <span class="uc-checkout__label">{{ section.settings.zip_label }} <em>*</em></span>
          <span class="uc-checkout__control">{%- render 'uc-icon', name: 'map-pin' -%}<input type="text" name="zip" inputmode="numeric" autocomplete="postal-code" maxlength="10" placeholder="{{ section.settings.zip_ph | escape }}" required data-uc-quote-zip></span>
        </label>

        <button type="submit" class="uc-checkout__pay" data-uc-quote-submit>
          {%- render 'uc-icon', name: 'lock' -%}<span>{{ section.settings.submit_label }}</span>{%- render 'uc-icon', name: 'arrow-right' -%}
        </button>
        <button type="button" class="uc-checkout__save" data-uc-quote-save>
          {%- render 'uc-icon', name: 'bookmark' -%}<span>{{ section.settings.save_label }}</span>
        </button>
        <p class="uc-checkout__status" data-uc-quote-status role="status" hidden></p>
      </form>

      <aside class="uc-checkout__card uc-checkout__summary" aria-label="Order summary">
        <div class="uc-checkout__sumhead">
          <h2>{{ section.settings.summary_heading }}</h2>
          <span data-uc-quote-itemcount>0 Items</span>
        </div>

        <ul class="uc-checkout__items" data-uc-quote-list></ul>
        <p class="uc-checkout__empty" data-uc-quote-empty hidden>
          {{ section.settings.empty_message }}
          <a href="{{ section.settings.browse_url | default: '/collections/all' }}">{{ section.settings.back_label }}</a>
        </p>

        <div class="uc-checkout__totals">
          <div class="uc-checkout__trow"><span data-uc-quote-sublabel>{{ section.settings.subtotal_label }}</span><span data-uc-quote-subtotal>—</span></div>
          <div class="uc-checkout__trow" data-uc-quote-taxrow hidden><span>{{ section.settings.tax_label }}</span><span data-uc-quote-tax></span></div>
          <div class="uc-checkout__trow uc-checkout__trow--total"><span>{{ section.settings.total_label }}</span><span data-uc-quote-total>—</span></div>
        </div>

        <div class="uc-checkout__note">
          {%- render 'uc-icon', name: 'truck' -%}
          <div><strong data-uc-quote-zipnote>{{ section.settings.zip_note_empty }}</strong><span>{{ section.settings.zip_note_body }}</span></div>
        </div>

        <div class="uc-checkout__tiles">
          <div class="uc-checkout__tile">{%- render 'uc-icon', name: 'shield-check' -%}<strong>{{ section.settings.tile1_heading }}</strong><span>{{ section.settings.tile1_body }}</span></div>
          <div class="uc-checkout__tile">{%- render 'uc-icon', name: 'circle-dollar-sign' -%}<strong>{{ section.settings.tile2_heading }}</strong><span>{{ section.settings.tile2_body }}</span></div>
          <div class="uc-checkout__tile">{%- render 'uc-icon', name: 'truck' -%}<strong>{{ section.settings.tile3_heading }}</strong><span>{{ section.settings.tile3_body }}</span></div>
        </div>

        <div class="uc-checkout__help">
          {%- render 'uc-icon', name: 'headset' -%}
          <div><strong>{{ section.settings.help_heading }}</strong><span>{{ section.settings.help_body }}</span></div>
          <a class="uc-checkout__mail" href="mailto:{{ section.settings.support_email }}">{%- render 'uc-icon', name: 'mail' -%}{{ section.settings.support_email }}</a>
        </div>
      </aside>

    </div>

    <div class="uc-checkout__card uc-checkout__done" data-uc-quote-done hidden>
      <span class="uc-checkout__donecheck">{%- render 'uc-icon', name: 'check' -%}</span>
      <h2>{{ section.settings.success_heading }}</h2>
      <p>{{ section.settings.success_body }}</p>
      <p class="uc-checkout__ref">{{ section.settings.reference_label }} <strong data-uc-quote-ref></strong></p>
      <div class="uc-checkout__doneactions">
        <a class="uc-checkout__pay" href="#" data-uc-quote-paylink hidden>{%- render 'uc-icon', name: 'lock' -%}<span>{{ section.settings.pay_now_label }}</span></a>
        <a class="uc-checkout__save" href="{{ section.settings.browse_url | default: '/collections/all' }}">{{ section.settings.back_label }}</a>
      </div>
    </div>

  </div>
</section>

