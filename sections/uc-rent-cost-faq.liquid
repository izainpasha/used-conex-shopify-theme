{%- comment -%} Used Conex — dark "How much does it cost" FAQ block with coins illustration {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-rent-cost uc-font">
  <div class="uc-wrap">
    <div class="uc-rent-cost__inner">
      <div class="uc-rent-cost__text">
        {%- for block in section.blocks -%}
          <div class="uc-rent-cost__item" {{ block.shopify_attributes }}>
            <h2 class="uc-rent-cost__title">{{ block.settings.title }}</h2>
            <div class="uc-rent-cost__body">{{ block.settings.body }}</div>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.image != blank -%}
        {%- assign uc_alt = section.settings.image.alt | default: section.settings.heading | default: section.settings.title | default: 'Shipping container rental costs' -%}{{ section.settings.image | image_url: width: 426 | image_tag: class: 'uc-rent-cost__img', alt: uc_alt, loading: 'lazy' }}
      {%- elsif section.settings.fallback_image_url != blank -%}
        {%- render 'uc-img', src: section.settings.fallback_image_url, class: 'uc-rent-cost__img', alt: 'Shipping container rental costs', widths: '213,426,640', sizes: '(min-width: 990px) 426px, 80vw' -%}
      {%- endif -%}
    </div>
  </div>
</section>

