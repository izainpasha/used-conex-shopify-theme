{%- comment -%}
  Used Conex — customer testimonial playlist (not in Figma; added at the
  user's request to preserve content the live site carries).
  Horizontal-scroll row of short click-to-play YouTube clips, reusing the
  same poster-from-YouTube-CDN + inject-iframe-on-click pattern as
  sections/uc-reviews.liquid.
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-reviews-playlist uc-font">
  <div class="uc-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="uc-section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="uc-reviews-playlist__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="uc-reviews-playlist__viewport">
      <div class="uc-reviews-playlist__row" data-uc-playlist-track data-uc-playlist-autoplay="{{ section.settings.autoplay | default: true }}" data-uc-playlist-interval="{{ section.settings.interval | default: 6 }}">
      {%- for block in section.blocks -%}
        {%- assign vid = block.settings.video_id | strip -%}
        {%- if vid != blank -%}
          <button class="uc-reviews-playlist__item"
                  type="button"
                  data-yt="{{ vid }}"
                  aria-label="Play video: {{ block.settings.label | default: 'Customer review' | escape }}"
                  {{ block.shopify_attributes }}>
            <img class="uc-reviews-playlist__poster"
                 src="https://i.ytimg.com/vi/{{ vid }}/maxresdefault.jpg"
                 onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ vid }}/hqdefault.jpg'"
                 alt="{{ block.settings.title | default: block.settings.label | default: 'Customer review video' | escape }}" loading="lazy" width="1280" height="720">
            <span class="uc-reviews-playlist__play" aria-hidden="true">
              <svg viewBox="0 0 68 48" width="44" height="31" focusable="false">
                <path class="uc-reviews-playlist__play-bg" d="M66.52 7.74a8.57 8.57 0 0 0-6.02-6.06C55.2.24 34 .24 34 .24s-21.2 0-26.5 1.44a8.57 8.57 0 0 0-6.02 6.06A89.5 89.5 0 0 0 0 24a89.5 89.5 0 0 0 1.48 16.26 8.57 8.57 0 0 0 6.02 6.06C12.8 47.76 34 47.76 34 47.76s21.2 0 26.5-1.44a8.57 8.57 0 0 0 6.02-6.06A89.5 89.5 0 0 0 68 24a89.5 89.5 0 0 0-1.48-16.26z"/>
                <path d="M27.2 34.4 45.6 24 27.2 13.6z" fill="#fff"/>
              </svg>
            </span>
            {%- if block.settings.label != blank -%}
              <span class="uc-reviews-playlist__label">{{ block.settings.label }}</span>
            {%- endif -%}
          </button>
        {%- endif -%}
      {%- endfor -%}
      </div>
      <button class="uc-reviews-playlist__nav uc-reviews-playlist__nav--prev" type="button" aria-label="Previous customer videos" data-uc-playlist-prev>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="uc-reviews-playlist__nav uc-reviews-playlist__nav--next" type="button" aria-label="More customer videos" data-uc-playlist-next>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</section>


