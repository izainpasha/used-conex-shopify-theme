{%- comment -%} Used Conex — Rent options (rent-to-own / short-term) pricing tables + rental application form {%- endcomment -%}{%- render 'uc-section-style', section: section -%}


<section class="uc-section uc-font" id="uc-rent-app-{{ section.id }}">
  <div class="uc-wrap">
    <h2 class="uc-rent-guide__title uc-rent-guide__rule">{{ section.settings.heading }}</h2>

    <div class="uc-rent-tabs" role="tablist">
      <button type="button" class="uc-rent-tabs__tab uc-rent-tabs__tab--active" data-rent-tab="1" role="tab" aria-selected="true">{{ section.settings.tab_1 }}</button>
      <button type="button" class="uc-rent-tabs__tab" data-rent-tab="2" role="tab" aria-selected="false">{{ section.settings.tab_2 }}</button>
    </div>

    <div class="uc-rent-pricing uc-rent-pricing--active" data-rent-panel="1" role="tabpanel">
      <div class="uc-rent-pricing__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'price_card' -%}
            <div class="uc-rent-pricing__card" {{ block.shopify_attributes }}>
              <h3 class="uc-rent-pricing__title">{{ block.settings.title }}</h3>
              {%- assign terms = block.settings.terms | newline_to_br | split: '<br />' -%}
              {%- for term in terms -%}
                {%- assign t = term | strip -%}
                {%- if t != blank -%}
                  {%- assign parts = t | split: '|' -%}
                  <div class="uc-rent-pricing__row">
                    <span class="uc-rent-pricing__term">{{ parts[0] | strip }}</span>
                    <span class="uc-rent-pricing__price">{{ parts[1] | strip }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="uc-rent-pricing__note">{{ section.settings.pricing_note }}</div>
    </div>

    <div class="uc-rent-pricing" data-rent-panel="2" role="tabpanel" hidden>
      <div class="uc-rent-pricing__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'short_term_card' -%}
            <div class="uc-rent-pricing__card" {{ block.shopify_attributes }}>
              <h3 class="uc-rent-pricing__title">{{ block.settings.title }}</h3>
              {%- assign terms = block.settings.terms | newline_to_br | split: '<br />' -%}
              {%- for term in terms -%}
                {%- assign t = term | strip -%}
                {%- if t != blank -%}
                  {%- assign parts = t | split: '|' -%}
                  <div class="uc-rent-pricing__row">
                    <span class="uc-rent-pricing__term">{{ parts[0] | strip }}</span>
                    <span class="uc-rent-pricing__price">{{ parts[1] | strip }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="uc-rent-pricing__note">{{ section.settings.short_term_note }}</div>
    </div>

    {%- form 'contact', id: 'uc-rent-form', class: 'uc-rent-form' -%}
      <input type="hidden" name="contact[tags]" value="rental-application">

      <h3 class="uc-rent-form__section-title uc-rent-form__section-title--first">{{ section.settings.personal_heading }}</h3>
      <div class="uc-rent-form__grid">
        <div class="uc-rent-form__field">
          <label for="rent-name">{{ section.settings.name_label }}</label>
          <input type="text" id="rent-name" name="contact[name]" placeholder="{{ section.settings.name_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-email">{{ section.settings.email_label }}</label>
          <input type="email" id="rent-email" name="contact[email]" placeholder="{{ section.settings.email_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-phone">{{ section.settings.phone_label }}</label>
          <input type="tel" id="rent-phone" name="contact[phone]" placeholder="{{ section.settings.phone_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-term">{{ section.settings.term_label }}</label>
          <select id="rent-term" name="contact[term_container]">
            {%- assign term_opts = section.settings.term_options | newline_to_br | split: '<br />' -%}
            {%- for opt in term_opts -%}
              {%- assign o = opt | strip -%}
              {%- if o != blank -%}<option value="{{ o | strip }}">{{ o | strip }}</option>{%- endif -%}
            {%- endfor -%}
          </select>
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-containers">{{ section.settings.containers_label }}</label>
          <input type="number" min="1" id="rent-containers" name="contact[num_containers]" value="1">
        </div>
        <div class="uc-rent-form__field uc-rent-form__field--wide">
          <label for="rent-address">{{ section.settings.address_label }}</label>
          <input type="text" id="rent-address" name="contact[delivery_address]" placeholder="{{ section.settings.address_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-zip">{{ section.settings.zip_label }}</label>
          <input type="text" id="rent-zip" name="contact[zip]" placeholder="{{ section.settings.zip_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-city">{{ section.settings.city_label }}</label>
          <input type="text" id="rent-city" name="contact[city]" placeholder="{{ section.settings.city_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-state">{{ section.settings.state_label }}</label>
          <input type="text" id="rent-state" name="contact[state]" placeholder="{{ section.settings.state_placeholder }}">
        </div>
      </div>

      <h3 class="uc-rent-form__section-title">{{ section.settings.employer_heading }}</h3>
      <div class="uc-rent-form__grid">
        <div class="uc-rent-form__field">
          <label for="rent-emp-type">{{ section.settings.employment_type_label }}</label>
          <select id="rent-emp-type" name="contact[employment_type]">
            {%- assign emp_opts = section.settings.employment_type_options | newline_to_br | split: '<br />' -%}
            {%- for opt in emp_opts -%}
              {%- assign o = opt | strip -%}
              {%- if o != blank -%}<option value="{{ o | strip }}">{{ o | strip }}</option>{%- endif -%}
            {%- endfor -%}
          </select>
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-emp-name">{{ section.settings.employer_name_label }}</label>
          <input type="text" id="rent-emp-name" name="contact[employer_name]" placeholder="{{ section.settings.employer_name_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-emp-phone">{{ section.settings.employer_phone_label }}</label>
          <input type="tel" id="rent-emp-phone" name="contact[employer_phone]" placeholder="{{ section.settings.employer_phone_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-emp-email">{{ section.settings.employer_email_label }}</label>
          <input type="email" id="rent-emp-email" name="contact[employer_email]" placeholder="{{ section.settings.employer_email_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-income">{{ section.settings.income_label }}</label>
          <input type="text" id="rent-income" name="contact[monthly_income]" placeholder="{{ section.settings.income_placeholder }}">
        </div>
        <div class="uc-rent-form__field uc-rent-form__field--upload">
          <label for="rent-paystubs">{{ section.settings.upload_label }}</label>
          <div class="uc-rent-form__dropzone">
            {%- if section.settings.upload_icon != blank -%}
              {{ section.settings.upload_icon | image_url: width: 64 | image_tag: class: 'uc-rent-form__upload-icon', alt: '', loading: 'lazy' }}
            {%- elsif section.settings.upload_icon_fallback_image_url != blank -%}
              {%- render 'uc-img', src: section.settings.upload_icon_fallback_image_url, class: 'uc-rent-form__upload-icon', decorative: true, widths: '32,64', sizes: '32px' -%}
            {%- endif -%}
            <p class="uc-rent-form__dropzone-title">{{ section.settings.upload_text }}</p>
            <p class="uc-rent-form__dropzone-note">{{ section.settings.upload_limit }}</p>
            <p class="uc-rent-form__dropzone-note">{{ section.settings.upload_size }}</p>
            <input type="file" id="rent-paystubs" name="contact[paystubs][]" multiple accept="application/pdf,image/*">
          </div>
        </div>
        <div class="uc-rent-form__field uc-rent-form__field--wide">
          <label for="rent-emp-address">{{ section.settings.address_label }}</label>
          <input type="text" id="rent-emp-address" name="contact[employer_address]" placeholder="{{ section.settings.address_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-emp-zip">{{ section.settings.zip_label }}</label>
          <input type="text" id="rent-emp-zip" name="contact[employer_zip]" placeholder="{{ section.settings.zip_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-emp-city">{{ section.settings.city_label }}</label>
          <input type="text" id="rent-emp-city" name="contact[employer_city]" placeholder="{{ section.settings.city_placeholder }}">
        </div>
        <div class="uc-rent-form__field">
          <label for="rent-emp-state">{{ section.settings.state_label }}</label>
          <input type="text" id="rent-emp-state" name="contact[employer_state]" placeholder="{{ section.settings.state_placeholder }}">
        </div>
      </div>

      <h3 class="uc-rent-form__section-title">{{ section.settings.agent_heading }}</h3>
      <div class="uc-rent-form__grid">
        <div class="uc-rent-form__field uc-rent-form__field--full">
          <label for="rent-agent">{{ section.settings.agent_label }}</label>
          <input type="text" id="rent-agent" name="contact[sales_agent]" placeholder="{{ section.settings.agent_placeholder }}">
        </div>
        <div class="uc-rent-form__field uc-rent-form__field--full">
          <label for="rent-comments">{{ section.settings.comments_label }}</label>
          <textarea id="rent-comments" name="contact[body]" rows="5" placeholder="{{ section.settings.comments_placeholder }}"></textarea>
        </div>
      </div>

      <button type="submit" class="uc-btn uc-btn--yellow uc-rent-form__submit">
        {{ section.settings.submit_label }}
        <svg class="uc-btn__arrow" viewBox="0 0 13 7" fill="none" aria-hidden="true"><path d="M0 3.5h11M8 1l3 2.5L8 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    {%- endform -%}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('uc-rent-app-{{ section.id }}');
  if (!root) return;
  var tabs = root.querySelectorAll('[data-rent-tab]');
  var panels = root.querySelectorAll('[data-rent-panel]');
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var idx = tab.getAttribute('data-rent-tab');
      tabs.forEach(function (t) {
        t.classList.remove('uc-rent-tabs__tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      panels.forEach(function (p) {
        p.classList.remove('uc-rent-pricing--active');
        p.hidden = true;
      });
      tab.classList.add('uc-rent-tabs__tab--active');
      tab.setAttribute('aria-selected', 'true');
      var panel = root.querySelector('[data-rent-panel="' + idx + '"]');
      if (panel) { panel.hidden = false; panel.classList.add('uc-rent-pricing--active'); }
    });
  });
})();
</script>

