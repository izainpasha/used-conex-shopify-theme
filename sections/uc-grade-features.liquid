{%- comment -%} Used Conex — Grade page "Features & Benefits" (dark bg, icon pill list left, image right with diagonal yellow divider). Reusable across grade pages. {%- endcomment -%}{%- render 'uc-section-style', section: section -%}


<section class="uc-grade-features uc-font">
  <div class="uc-grade-features__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.heading, loading: 'lazy' }}
    {%- elsif section.settings.fallback_image_url != blank -%}
      {%- render 'uc-img', src: section.settings.fallback_image_url, alt: section.settings.heading, widths: '360,540,720,960,1200', sizes: '(min-width: 990px) 50vw, 100vw' -%}
    {%- endif -%}
  </div>
  <div class="uc-wrap">
    <div class="uc-grade-features__inner">
      <h2 class="uc-grade-features__title">{{ section.settings.heading }}</h2>
      <div class="uc-grade-features__grid">
        {%- for block in section.blocks -%}
          <div class="uc-grade-features__pill{% if block.settings.wide %} uc-grade-features__pill--wide{% endif %}" {{ block.shopify_attributes }}>
            <span class="uc-grade-features__icon">
              {%- comment -%} Real icons exported from Figma, stored as Shopify Files {%- endcomment -%}
              {%- if block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 56 | image_tag: alt: block.settings.label, loading: 'lazy' }}
              {%- else -%}
                {%- assign uc_icon_src = 'https://cdn.shopify.com/s/files/1/1029/2284/6530/files/uc-grade-icon-' | append: block.settings.icon | append: '.png' -%}{%- render 'uc-img', src: uc_icon_src, decorative: true, width: 28, height: 28, widths: '28,56', sizes: '28px' -%}
              {%- endif -%}
            </span>
            <span class="uc-grade-features__label">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
