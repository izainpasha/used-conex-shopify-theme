{%- comment -%} Used Conex — Rent page intro paragraph {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-rent-intro-section uc-font">
  <div class="uc-wrap">
    <div class="uc-rent-intro">
      <div class="uc-rent-intro__rule">
        <h2 class="uc-rent-intro__heading">{{ section.settings.heading }}</h2>
      </div>
      <div class="uc-rent-intro__body">{{ section.settings.body }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UC Rent Intro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rent a Shipping Container: Affordable, Flexible, and Convenient Solutions"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Are you in need of extra storage or a secure space for your business, construction project, or personal use? Renting a shipping container offers an affordable, flexible solution tailored to your needs. Whether you’re moving, renovating, or storing excess inventory, a shipping container provides an easy-to-access, weatherproof space without the long-term commitment of owning one. With a variety of container sizes and rental options, you can find the perfect solution for your short or long-term needs. Rent a container from us today and enjoy secure, reliable storage delivered to your doorstep.</p>"
    },
    {
      "type": "header",
      "content": "Section style — colors"
    },
    {
      "type": "paragraph",
      "content": "Everything under Section style is optional. Leave a field empty to keep the design as built."
    },
    {
      "type": "color_background",
      "id": "st_bg",
      "label": "Background (color or gradient)"
    },
    {
      "type": "image_picker",
      "id": "st_bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "st_overlay",
      "label": "Background image darkening",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "st_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "st_text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Section style — typography"
    },
    {
      "type": "checkbox",
      "id": "st_custom_fonts",
      "label": "Use custom fonts in this section",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "st_heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "st_body_font",
      "label": "Text and button font",
      "default": "assistant_n4"
    },
    {
      "type": "number",
      "id": "st_heading_size",
      "label": "Main heading size (px, desktop)"
    },
    {
      "type": "number",
      "id": "st_subheading_size",
      "label": "Sub heading size (px, desktop)"
    },
    {
      "type": "select",
      "id": "st_heading_weight",
      "label": "Heading weight",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ]
    },
    {
      "type": "select",
      "id": "st_heading_case",
      "label": "Heading letter case",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "none",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
          "label": "Capitalize Each Word"
        }
      ]
    },
    {
      "type": "number",
      "id": "st_heading_spacing",
      "label": "Heading letter spacing (px)"
    },
    {
      "type": "number",
      "id": "st_text_size",
      "label": "Text size (px, desktop)"
    },
    {
      "type": "number",
      "id": "st_line_height",
      "label": "Text line height (%)",
      "info": "e.g. 150 = 1.5 line height"
    },
    {
      "type": "select",
      "id": "st_align",
      "label": "Text alignment (desktop)",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section style — spacing and width"
    },
    {
      "type": "number",
      "id": "st_pt",
      "label": "Padding top (px, desktop)"
    },
    {
      "type": "number",
      "id": "st_pb",
      "label": "Padding bottom (px, desktop)"
    },
    {
      "type": "number",
      "id": "st_mt",
      "label": "Space above section (px)"
    },
    {
      "type": "number",
      "id": "st_mb",
      "label": "Space below section (px)"
    },
    {
      "type": "number",
      "id": "st_width",
      "label": "Content max width (px)"
    },
    {
      "type": "number",
      "id": "st_gutter",
      "label": "Side padding (px, desktop)"
    },
    {
      "type": "header",
      "content": "Section style — mobile"
    },
    {
      "type": "number",
      "id": "st_pt_m",
      "label": "Padding top (px, mobile)"
    },
    {
      "type": "number",
      "id": "st_pb_m",
      "label": "Padding bottom (px, mobile)"
    },
    {
      "type": "number",
      "id": "st_gutter_m",
      "label": "Side padding (px, mobile)"
    },
    {
      "type": "number",
      "id": "st_heading_size_m",
      "label": "Main heading size (px, mobile)"
    },
    {
      "type": "number",
      "id": "st_subheading_size_m",
      "label": "Sub heading size (px, mobile)"
    },
    {
      "type": "number",
      "id": "st_text_size_m",
      "label": "Text size (px, mobile)"
    },
    {
      "type": "select",
      "id": "st_align_m",
      "label": "Text alignment (mobile)",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "st_btn_full_m",
      "label": "Full-width buttons on mobile",
      "default": false
    },
    {
      "type": "number",
      "id": "st_img_height_m",
      "label": "Image height (px, mobile)"
    },
    {
      "type": "header",
      "content": "Section style — buttons"
    },
    {
      "type": "color",
      "id": "st_btn_bg",
      "label": "Button background"
    },
    {
      "type": "color",
      "id": "st_btn_color",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "st_btn_bg_hover",
      "label": "Button background on hover"
    },
    {
      "type": "color",
      "id": "st_btn_color_hover",
      "label": "Button text on hover"
    },
    {
      "type": "number",
      "id": "st_btn_radius",
      "label": "Button corner radius (px)"
    },
    {
      "type": "number",
      "id": "st_btn_size",
      "label": "Button text size (px)"
    },
    {
      "type": "number",
      "id": "st_btn_height",
      "label": "Button height (px)"
    },
    {
      "type": "number",
      "id": "st_btn_pad_x",
      "label": "Button side padding (px)"
    },
    {
      "type": "select",
      "id": "st_btn_case",
      "label": "Button letter case",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "none",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
          "label": "Capitalize Each Word"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section style — images"
    },
    {
      "type": "number",
      "id": "st_img_radius",
      "label": "Image and video corner radius (px)"
    },
    {
      "type": "select",
      "id": "st_img_fit",
      "label": "Image fit",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "cover",
          "label": "Fill (crop)"
        },
        {
          "value": "contain",
          "label": "Fit (no crop)"
        }
      ]
    },
    {
      "type": "number",
      "id": "st_img_height",
      "label": "Image height (px, desktop)"
    },
    {
      "type": "header",
      "content": "Section style — visibility"
    },
    {
      "type": "checkbox",
      "id": "st_hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "st_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "UC Rent Intro"
    }
  ]
}
{% endschema %}
