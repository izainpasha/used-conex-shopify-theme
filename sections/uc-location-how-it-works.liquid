{%- comment -%} Used Conex — Location page "How It Works" 3-step band (Figma 274:771) {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-location-steps uc-font">
  <div class="uc-wrap">
    <h2 class="uc-section-title">{{ section.settings.heading }}</h2>
    <p class="uc-location-steps__intro">{{ section.settings.intro }}</p>

    <div class="uc-location-steps__grid">
      {%- for block in section.blocks -%}
        <div class="uc-location-steps__card" {{ block.shopify_attributes }}>
          <div class="uc-location-steps__number">{{ block.settings.number }}</div>
          <h3 class="uc-location-steps__title">{{ block.settings.title }}</h3>
          <p class="uc-location-steps__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UC Location How It Works",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
