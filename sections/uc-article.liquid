{%- comment -%}
  Used Conex — article page.

  Replaces Dawn's default main-article. Three parts: a hero built from the
  post's own featured image, the body in a readable single column, and related
  posts reusing the .uc-news__card idiom from the blog listing so the two pages
  read as one feature.
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<article class="uc-article uc-font">

  <header class="uc-article__hero">
    {%- if article.image -%}
      {{ article.image | image_url: width: 1920 | image_tag: class: 'uc-article__hero-bg', alt: article.title, loading: 'eager', widths: '750,1100,1500,1920' }}
    {%- elsif section.settings.fallback_image_url != blank -%}
      {%- render 'uc-img', src: section.settings.fallback_image_url, class: 'uc-article__hero-bg', decorative: true, priority: true -%}
    {%- endif -%}
    <div class="uc-article__hero-overlay"></div>

    <div class="uc-wrap uc-article__hero-inner">
      <nav class="uc-article__crumbs" aria-label="Breadcrumb">
        <a href="{{ blog.url }}">{{ section.settings.blog_label }}</a>
        <span aria-hidden="true">/</span>
        <span>{{ article.title }}</span>
      </nav>

      <h1 class="uc-article__title">{{ article.title }}</h1>

      <p class="uc-article__meta">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%B %d, %Y' }}
        </time>
        {%- assign words = article.content | strip_html | split: ' ' | size -%}
        {%- assign mins = words | divided_by: 200 | plus: 1 -%}
        <span aria-hidden="true">·</span>
        <span>{{ mins }} {{ section.settings.min_read_label }}</span>
      </p>
    </div>
  </header>

  <div class="uc-section uc-article__body">
    <div class="uc-wrap">
      <div class="uc-article__content rte">
        {%- render 'uc-article-html', content: article.content, title: article.title -%}
      </div>

      <div class="uc-article__foot">
        <a class="uc-article__back" href="{{ blog.url }}">
          <svg viewBox="0 0 20 10" fill="none" aria-hidden="true">
            <path d="M18 5H2m0 0l4-4M2 5l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {{ section.settings.back_label }}
        </a>

        {%- if section.settings.show_share -%}
          <div class="uc-article__share">
            <span>{{ section.settings.share_label }}</span>
            {%- assign share_url = shop.url | append: article.url | url_encode -%}
            {%- assign share_title = article.title | url_encode -%}
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
            </a>
            <a href="https://twitter.com/intent/tweet?url={{ share_url }}&text={{ share_title }}" target="_blank" rel="noopener" aria-label="Share on X">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41z"/></svg>
            </a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url }}" target="_blank" rel="noopener" aria-label="Share on LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 110-4.14 2.07 2.07 0 010 4.14zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- assign related = blog.articles | where: 'id', article.id -%}
  {%- if blog.articles.size > 1 -%}
    <section class="uc-section uc-article__related">
      <div class="uc-wrap">
        <h2 class="uc-section-title">{{ section.settings.related_heading }}</h2>
        <div class="uc-news__grid">
          {%- assign shown = 0 -%}
          {%- for post in blog.articles -%}
            {%- if post.id != article.id and shown < 3 -%}
              {%- assign shown = shown | plus: 1 -%}
              <article class="uc-news__card">
                {%- if post.image -%}
                  {{ post.image | image_url: width: 920 | image_tag: class: 'uc-news__card-bg', alt: post.title, loading: 'lazy' }}
                {%- elsif section.settings.fallback_image_url != blank -%}
                  {%- render 'uc-img', src: section.settings.fallback_image_url, class: 'uc-news__card-bg', decorative: true, widths: '360,540,720,920', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw' -%}
                {%- endif -%}
                <span class="uc-news__tag">{{ section.settings.blog_label }}</span>
                <h3 class="uc-news__title">{{ post.title }}</h3>
                <div class="uc-news__rule"></div>
                <p class="uc-news__excerpt">{{ post.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
                <a class="uc-news__more" href="{{ post.url }}">{{ section.settings.read_more_label }}</a>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

</article>

