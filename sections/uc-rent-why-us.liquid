{%- comment -%} Used Conex — dark "We know that you have options" block with pusher illustration {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-rent-why uc-font">
  <div class="uc-wrap uc-wrap--rent-why">
    <div class="uc-rent-why__text">
      <p class="uc-rent-why__lede">{{ section.settings.text }}</p>
      <p class="uc-rent-why__emphasis">{{ section.settings.emphasis }}</p>
    </div>
    {%- if section.settings.image != blank -%}
      {%- assign uc_alt = section.settings.image.alt | default: section.settings.heading | default: section.settings.title | default: 'Why rent a shipping container from Used Conex' -%}{{ section.settings.image | image_url: width: 468 | image_tag: class: 'uc-rent-why__img', alt: uc_alt, loading: 'lazy' }}
    {%- elsif section.settings.fallback_image_url != blank -%}
      {%- render 'uc-img', src: section.settings.fallback_image_url, class: 'uc-rent-why__img', alt: 'Why rent a shipping container from Used Conex', widths: '234,468,702', sizes: '(min-width: 990px) 468px, 80vw' -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "UC Rent Why Us",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We know that you have options when it comes to shipping, container rentals near you. We also know that we’re the preffered rental company for many customers for a reason."
    },
    {
      "type": "textarea",
      "id": "emphasis",
      "label": "Emphasis text",
      "default": "Enjoy a flexible range of options, competetive pricing, and a speedy application process at Used Conex."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Illustration"
    },
    {
      "type": "text",
      "id": "fallback_image_url",
      "label": "Fallback illustration URL",
      "info": "Used only if no illustration is selected above",
      "default": "https://cdn.shopify.com/s/files/1/1029/2284/6530/files/uc-rent-pusher-clean.png"
    },
    {
      "type": "header",
      "content": "Section style — colors"
    },
    {
      "type": "paragraph",
      "content": "Everything under Section style is optional. Leave a field empty to keep the design as built."
    },
    {
      "type": "color_background",
      "id": "st_bg",
      "label": "Background (color or gradient)"
