{%- comment -%}
  Used Conex — Meet The Team.
  Renders as an auto-scrolling marquee: the block list is output twice so the
  track can loop seamlessly (the animation translates by exactly -50%).
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-section uc-font">
  <div class="uc-wrap">
    <h2 class="uc-section-title">{{ section.settings.heading }}</h2>
  </div>

  <div class="uc-team__marquee" data-uc-team-marquee>
    <div
      class="uc-team__track"
      style="--uc-team-duration: {{ section.settings.speed | default: 90 }}s"
    >
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <div
            class="uc-team__card"
            {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}
          >
            {%- assign uc_team_alt = block.settings.name | append: ', Used Conex team' -%}
            {%- if block.settings.photo != blank -%}
              {%- render 'uc-img', image: block.settings.photo, class: 'uc-team__photo', alt: uc_team_alt, decorative: forloop.parentloop.last, width: 300, height: 300, widths: '200,300,450,600', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw' -%}
            {%- elsif block.settings.fallback_image_url != blank -%}
              {%- render 'uc-img', src: block.settings.fallback_image_url, class: 'uc-team__photo', alt: uc_team_alt, decorative: forloop.parentloop.last, width: 300, height: 300, widths: '200,300,450,600', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw' -%}
            {%- else -%}
              <div class="uc-team__photo" style="background:#d9d9d9"></div>
            {%- endif -%}
            <p class="uc-team__name">{{ block.settings.name }}</p>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

