{%- comment -%} Used Conex — custom footer (pixel-matched to Figma) {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<footer class="uc-footer uc-font" role="contentinfo">
  <div class="uc-footer__inner">
    <div class="uc-footer__col1">
    <div class="uc-footer__brand">
      <a href="{{ routes.root_url }}" class="uc-footer__brand-logo-link" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 710 | image_tag: class: 'uc-footer__brand-logo', alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <img class="uc-footer__brand-logo" src="https://cdn.shopify.com/s/files/1/1029/2284/6530/files/uc-logo.png" alt="{{ shop.name }}" width="308" height="40" loading="lazy">
        {%- endif -%}
      </a>
      <p class="uc-footer__tagline">{{ section.settings.tagline }}</p>

      <div class="uc-footer__contact">
        {%- if section.settings.phone != blank -%}
          <div class="uc-footer__contact-row">
            <span class="uc-footer__contact-ico">
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.36 3.33333C4.4 3.92667 4.5 4.50667 4.66 5.06L3.86 5.86C3.58667 5.06 3.41333 4.21333 3.35333 3.33333H4.36ZM10.9333 11.3467C11.5 11.5067 12.08 11.6067 12.6667 11.6467V12.64C11.7867 12.58 10.94 12.4067 10.1333 12.14L10.9333 11.3467ZM5 2H2.66667C2.3 2 2 2.3 2 2.66667C2 8.92667 7.07333 14 13.3333 14C13.7 14 14 13.7 14 13.3333V11.0067C14 10.64 13.7 10.34 13.3333 10.34C12.5067 10.34 11.7 10.2067 10.9533 9.96C10.8873 9.93535 10.8171 9.92402 10.7467 9.92667C10.5733 9.92667 10.4067 9.99333 10.2733 10.12L8.80667 11.5867C6.91698 10.6202 5.37978 9.08302 4.41333 7.19333L5.88 5.72667C6.06667 5.54 6.12 5.28 6.04667 5.04667C5.79421 4.2786 5.66593 3.47516 5.66667 2.66667C5.66667 2.3 5.36667 2 5 2Z" fill="#000"/></svg>
            </span>
            <span>
              <span class="uc-footer__contact-label">{{ section.settings.phone_label }}</span>
              <a class="uc-footer__contact-value" href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}">{{ section.settings.phone }}</a>
            </span>
          </div>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <div class="uc-footer__contact-row">
            <span class="uc-footer__contact-ico">
              <svg viewBox="0 0 13.3333 12.3333" fill="none" aria-hidden="true"><path d="M10.1667 0.5H3.16667C1.69391 0.5 0.5 1.69391 0.5 3.16667V9.16667C0.5 10.6394 1.69391 11.8333 3.16667 11.8333H10.1667C11.6394 11.8333 12.8333 10.6394 12.8333 9.16667V3.16667C12.8333 1.69391 11.6394 0.5 10.1667 0.5Z" stroke="#000"/><path d="M0.531333 3.22667L5.33467 5.98C5.73718 6.21357 6.19429 6.33659 6.65967 6.33659C7.12504 6.33659 7.58215 6.21357 7.98467 5.98L12.8013 3.22667" stroke="#000" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>
              <span class="uc-footer__contact-label">{{ section.settings.email_label }}</span>
              <a class="uc-footer__contact-value" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </span>
          </div>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <div class="uc-footer__contact-row">
            <span class="uc-footer__contact-ico">{%- render 'uc-icon', name: 'map-pin' -%}</span>
            <span>
              <span class="uc-footer__contact-label">{{ section.settings.address_label }}</span>
              <a class="uc-footer__contact-value" href="https://www.google.com/maps/search/?api=1&query={{ section.settings.address | url_encode }}" target="_blank" rel="noopener">{{ section.settings.address }}</a>
            </span>
          </div>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <div class="uc-footer__contact-row">
            <span class="uc-footer__contact-ico">{%- render 'uc-icon', name: 'clock' -%}</span>
            <span>
              <span class="uc-footer__contact-label">{{ section.settings.hours_label }}</span>
              <span class="uc-footer__contact-value">{{ section.settings.hours }}</span>
            </span>
          </div>
        {%- endif -%}
      </div>
    </div>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu_column' -%}
        <div class="uc-footer__col" {{ block.shopify_attributes }}>
          <div class="uc-footer__heading">{{ block.settings.heading }}</div>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}"{% if link.url contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}
    <div class="uc-footer__socials">
        {% if section.settings.instagram != blank %}
