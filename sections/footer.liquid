      "id": "phone_label",
      "label": "Phone label",
      "default": "PHONE"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "EMAIL"
    },
    {
      "type": "text",
      "id": "address_label",
      "label": "Address label",
      "default": "ADDRESS"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "BUSINESS HOURS"
    },
    {
      "type": "text",
      "id": "rights_text",
      "label": "Text after copyright name",
      "default": "All rights reserved."
    },
    {
      "type": "header",
      "content": "Section style — colors"
    },
    {
      "type": "paragraph",
      "content": "Everything under Section style is optional. Leave a field empty to keep the design as built."
    },
    {
      "type": "color_background",
      "id": "st_bg",
      "label": "Background (color or gradient)"
    },
    {
      "type": "image_picker",
      "id": "st_bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "st_overlay",
      "label": "Background image darkening",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "st_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "st_text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Section style — typography"
    },
    {
      "type": "checkbox",
      "id": "st_custom_fonts",
      "label": "Use custom fonts in this section",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "st_heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "st_body_font",
      "label": "Text and button font",
      "default": "assistant_n4"
    },
    {
      "type": "number",
      "id": "st_heading_size",
      "label": "Main heading size (px, desktop)"
    },
    {
      "type": "number",
      "id": "st_subheading_size",
      "label": "Sub heading size (px, desktop)"
    },
    {
      "type": "select",
      "id": "st_heading_weight",
      "label": "Heading weight",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "400",
          "label": "Regular"
        },
