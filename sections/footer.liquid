2.2117 9.05127 22.3989 9.50796 22.7269 9.84616C23.0548 10.1844 23.4977 10.3774 23.9614 10.3844C24.4252 10.3914 24.8733 10.2117 25.2107 9.8835Z" fill="white"/></svg></a>
        {% endif %}
        {% if section.settings.facebook != blank %}
          <a href="{{ section.settings.facebook }}" aria-label="Facebook"><svg viewBox="0 0 32 33" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M0 16.5921C0 24.7968 5.77733 31.6167 13.3333 33V21.0829H9.33333V16.5H13.3333V12.8329C13.3333 8.70788 15.9107 6.41712 19.556 6.41712C20.7107 6.41712 21.956 6.6 23.1107 6.78288V11H21.0667C19.1107 11 18.6667 12.0079 18.6667 13.2921V16.5H22.9333L22.2227 21.0829H18.6667V33C26.2227 31.6167 32 24.7968 32 16.5921C32 7.46625 24.8 0 16 0C7.2 0 0 7.46625 0 16.5921Z" fill="white"/></svg></a>
        {% endif %}
        {% if section.settings.linkedin != blank %}
          <a href="{{ section.settings.linkedin }}" aria-label="LinkedIn"><svg viewBox="0 0 33 33" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.9649 12.3324H18.0716V14.8761C18.8072 13.4131 20.6937 12.0986 23.5276 12.0986C28.9602 12.0986 30.25 15.0109 30.25 20.3541V30.25H24.75V21.571C24.75 18.5281 24.0144 16.8121 22.1416 16.8121C19.5442 16.8121 18.4649 18.6615 18.4649 21.5696V30.25H12.9649V12.3324ZM3.53375 30.0162H9.03375V12.0986H3.53375V30.0162ZM9.82163 6.25625C9.82183 6.71725 9.7304 7.1737 9.55266 7.59906C9.37491 8.02442 9.1144 8.41021 8.78625 8.734C8.45713 9.06141 8.06672 9.32076 7.63733 9.49724C7.20794 9.67371 6.74799 9.76385 6.28375 9.7625C5.3482 9.7604 4.45076 9.39164 3.784 8.73538C3.45716 8.41039 3.19761 8.02415 3.02018 7.59876C2.84276 7.17336 2.75095 6.71716 2.75 6.25625C2.75 5.32538 3.12125 4.43438 3.78538 3.77713C4.45047 3.11834 5.34899 2.74914 6.28513 2.75C7.22288 2.75 8.12212 3.11988 8.78625 3.77713C9.45037 4.43438 9.82163 5.32538 9.82163 6.25625Z" fill="white"/></svg></a>
        {% endif %}
        {% if section.settings.youtube != blank %}
          <a href="{{ section.settings.youtube }}" aria-label="YouTube"><svg viewBox="0 0 32 33" fill="none" aria-hidden="true"><path d="M29.4156 9.54229C29.2562 8.9301 28.9437 8.37183 28.5094 7.92334C28.075 7.47485 27.5341 7.15186 26.9406 6.98672C24.7562 6.38086 16 6.38086 16 6.38086C16 6.38086 7.24375 6.38086 5.05937 6.9835C4.46569 7.14811 3.92445 7.47091 3.49002 7.91948C3.05558 8.36806 2.74325 8.92662 2.58437 9.53906C2 11.7949 2 16.5 2 16.5C2 16.5 2 21.2051 2.58437 23.4577C2.90625 24.7017 3.85625 25.6813 5.05937 26.0133C7.24375 26.6191 16 26.6191 16 26.6191C16 26.6191 24.7562 26.6191 26.9406 26.0133C28.1469 25.6813 29.0937 24.7017 29.4156 23.4577C30 21.2051 30 16.5 30 16.5C30 16.5 30 11.7949 29.4156 9.54229ZM13.2188 20.8184V12.1816L20.4688 16.4678L13.2188 20.8184Z" fill="white"/></svg></a>
        {% endif %}
        {% if section.settings.twitter != blank %}
          <a href="{{ section.settings.twitter }}" aria-label="Twitter"><svg viewBox="0 0 32 33" fill="none" aria-hidden="true"><path d="M31.5237 6.78842C30.4104 7.29717 29.2144 7.64092 27.957 7.79629C29.2544 6.99576 30.2249 5.73581 30.6877 4.25154C29.4688 4.99816 28.1348 5.52369 26.7437 5.8053C25.8082 4.77523 24.5691 4.09249 23.2188 3.86307C21.8685 3.63365 20.4825 3.87038 19.276 4.53652C18.0695 5.20265 17.1101 6.26092 16.5466 7.54701C15.9831 8.83311 15.8471 10.2751 16.1597 11.649C13.69 11.5211 11.2739 10.8591 9.06831 9.70592C6.86272 8.55279 4.91687 6.93433 3.35702 4.95554C2.82369 5.90429 2.51702 7.00429 2.51702 8.17579C2.51643 9.23041 2.76827 10.2689 3.25019 11.1991C3.73212 12.1292 4.42924 12.9223 5.27969 13.508C4.29342 13.4755 3.32891 13.2007 2.46636 12.7064V12.7889C2.46626 14.2681 2.9624 15.7017 3.8706 16.8465C4.7788 17.9914 6.04312 18.7769 7.44902 19.0699C6.53401 19.3249 5.57484 19.3625 4.64369 19.1799C5.04018 20.4527 5.8128 21.5658 6.85333 22.3632C7.89386 23.1606 9.1502 23.6024 10.4464 23.6267C8.24603 25.4077 5.52884 26.3738 2.73169 26.3698C2.23624 26.3684 1.74125 26.3386 1.24902 26.2804C4.08911 28.1613 7.39375 29.1602 10.769 29.1583C22.1957 29.1583 28.4424 19.3985 28.4424 10.934C28.4424 10.6581 28.4361 10.3822 28.4237 10.1063C29.6382 9.19947 30.6869 8.07747 31.521 6.79254L31.5237 6.78842Z" fill="white"/></svg></a>
        {% endif %}
    </div>
    {%- assign pay_types = section.settings.payment_types | remove: ' ' | split: ',' -%}
    {%- if pay_types.size > 0 -%}
      <div class="uc-footer__payments">
        <span class="uc-footer__payments-label">{{ section.settings.payments_label }}</span>
        <ul class="uc-footer__payments-list" role="list">
          {%- for type in pay_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'uc-payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>

  <div class="uc-footer__bottom">
    <span>&copy; {{ section.settings.copyright | default: shop.name }} {{ section.settings.rights_text }}</span>

    {%- if section.settings.policy_links != blank -%}
      <span>
        {%- for link in section.settings.policy_links.links -%}
          <a href="{{ link.url }}"{% if link.url contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a>{% unless forloop.last %} &middot; {% endunless %}
        {%- endfor -%}
      </span>
    {%- endif -%}
  </div>
</footer>
<style>
  .uc-footer__tagline {
    font-weight: 600;
  }
</style>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Containers for storage, business, construction, and everything in between."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+1-800-230-7764"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@usedconex.com"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Business address",
      "default": "5401 West Kennedy Blvd, Suite 100, Tampa, FL 33609"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business hours",
      "default": "8am – 6pm EST"
    },
    {
      "type": "header",
      "content": "Payment logos"
    },
    {
      "type": "text",
      "id": "payments_label",
      "label": "Label",
      "default": "We accept"
    },
    {
      "type": "text",
      "id": "payment_types",
      "label": "Cards shown",
      "info": "Comma-separated Shopify card names, e.g. visa, master, discover, american_express.",
      "default": "visa, master, discover, american_express"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "linkedin",
      "label": "LinkedIn"
    },
    {
      "type": "url",
      "id": "youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "twitter",
      "label": "Twitter"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright name",
      "default": "Used Conex"
    },
    {
      "type": "link_list",
      "id": "policy_links",
