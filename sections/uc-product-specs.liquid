{%- comment -%}
  Used Conex — standalone Condition & Specifications section for product pages.
  Reads entirely from product metafields (custom.condition + the 8 dimension
  fields). Nothing here comes from the product description.
{%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

{%- assign mf = product.metafields.custom -%}
{%- assign condition_raw = mf.condition.value -%}

{%- capture spec_values -%}
{{ mf.external_length.value }}|{{ mf.external_width.value }}|{{ mf.external_height.value }}|{{ mf.interior_length.value }}|{{ mf.interior_width.value }}|{{ mf.interior_height.value }}|{{ mf.tare_weight.value }}|{{ mf.max_payload.value }}
{%- endcapture -%}
{%- assign spec_list = spec_values | strip | split: '|' -%}
{%- assign spec_labels = 'External length,External width,External height,Interior length,Interior width,Interior height,Tare weight,Max payload' | split: ',' -%}

{%- assign has_specs = false -%}
{%- for v in spec_list -%}
  {%- if v != blank %}{% assign has_specs = true %}{% endif -%}
{%- endfor -%}

{%- if condition_raw != blank or has_specs -%}
  <section class="uc-section uc-font uc-pspecs">
    <div class="uc-wrap">
      <h2 class="uc-section-title">{{ section.settings.heading }}</h2>

      <div class="uc-pspecs__grid">

        {%- if condition_raw != blank -%}
          {%- assign lines = condition_raw | strip | newline_to_br | split: '<br />' -%}
          <div class="uc-pspecs__panel">
            <h3 class="uc-pspecs__subhead">{{ section.settings.condition_heading }}</h3>
            <ul class="uc-pspecs__list">
              {%- for line in lines -%}
                {%- assign l = line | strip -%}
                {%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if has_specs -%}
          <div class="uc-pspecs__panel uc-pspecs__panel--accent">
            <h3 class="uc-pspecs__subhead">{{ section.settings.specs_heading }}</h3>
            <dl class="uc-pspecs__table">
              {%- for label in spec_labels -%}
                {%- assign val = spec_list[forloop.index0] | strip -%}
                {%- if val != blank -%}
                  <div class="uc-pspecs__row">
                    <dt>{{ label }}</dt>
                    <dd>{{ val }}</dd>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </dl>
          </div>
        {%- endif -%}

      </div>

      {%- if section.settings.note != blank -%}
        <p class="uc-pspecs__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
