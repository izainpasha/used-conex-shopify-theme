{%- comment -%} Used Conex — Ready To Shop CTA banner {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-section uc-font" style="padding-block:32px">
  <div class="uc-wrap">
    <div class="uc-cta">
      <span class="uc-cta__accent" aria-hidden="true"></span>
      {%- if section.settings.image != blank -%}
        {%- assign uc_alt = section.settings.image.alt | default: section.settings.heading | default: section.settings.title | default: 'Shipping containers ready for delivery' -%}{{ section.settings.image | image_url: width: 1400 | image_tag: class: 'uc-cta__media', alt: uc_alt, loading: 'lazy' }}
      {%- elsif section.settings.fallback_image_url != blank -%}
        {%- render 'uc-img', src: section.settings.fallback_image_url, class: 'uc-cta__media', alt: 'Shipping containers ready for delivery', widths: '360,540,720,960,1400', sizes: '(min-width: 990px) 50vw, 100vw' -%}
      {%- endif -%}
      <h2 class="uc-cta__title">{{ section.settings.heading }}</h2>
      <a class="uc-btn uc-btn--yellow" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
        <svg class="uc-btn__arrow" viewBox="0 0 13 7" fill="none" aria-hidden="true"><path d="M0 3.5h11M8 1l3 2.5L8 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UC CTA Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready To Shop Containers"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Containers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image"
    },
    {
      "type": "text",
      "id": "fallback_image_url",
      "label": "Fallback side image URL",
      "info": "Used only if no image is selected above",
      "default": "https://cdn.shopify.com/s/files/1/1029/2284/6530/files/uc-cta-side.jpg"
    },
    {
      "type": "header",
      "content": "Section style — colors"
    },
    {
      "type": "paragraph",
      "content": "Everything under Section style is optional. Leave a field empty to keep the design as built."
    },
    {
      "type": "color_background",
      "id": "st_bg",
      "label": "Background (color or gradient)"
    },
    {
      "type": "image_picker",
      "id": "st_bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "st_overlay",
      "label": "Background image darkening",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "st_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "st_text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Section style — typography"
    },
    {
      "type": "checkbox",
      "id": "st_custom_fonts",
      "label": "Use custom fonts in this section",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "st_heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "st_body_font",
      "label": "Text and button font",
      "default": "assistant_n4"
    },
    {
      "type": "number",
      "id": "st_heading_size",
      "label": "Main heading size (px, desktop)"
    },
    {
      "type": "number",
      "id": "st_subheading_size",
      "label": "Sub heading size (px, desktop)"
    },
    {
      "type": "select",
      "id": "st_heading_weight",
      "label": "Heading weight",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ]
    },
    {
      "type": "select",
      "id": "st_heading_case",
      "label": "Heading letter case",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "none",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
