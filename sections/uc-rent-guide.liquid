{%- comment -%} Used Conex — How to Rent guide: tips list + illustration, paperwork checklist, container types grid {%- endcomment -%}
{%- render 'uc-section-style', section: section -%}

<section class="uc-section uc-font">
  <div class="uc-wrap">
    <h2 class="uc-rent-guide__title uc-rent-guide__rule">{{ section.settings.heading }}</h2>
    <p class="uc-rent-guide__lede">{{ section.settings.intro }}</p>

    <div class="uc-rent-guide__row">
      <div class="uc-rent-guide__col">
        <p class="uc-rent-guide__kicker">{{ section.settings.tips_kicker }}</p>
        <ul class="uc-rent-guide__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tip' -%}
              <li {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b> {{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <p class="uc-rent-guide__para">{{ section.settings.reviews_text }}</p>
        <ul class="uc-rent-guide__list uc-rent-guide__list--wide">
          {%- for block in section.blocks -%}
            {%- if block.type == 'cost_tip' -%}
              <li {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b> {{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <p class="uc-rent-guide__para">{{ section.settings.deposit_text }}</p>
      </div>
      <div class="uc-rent-guide__media">
        {%- if section.settings.tips_image != blank -%}
          {%- assign uc_alt = section.settings.tips_image.alt | default: section.settings.heading | default: section.settings.title | default: 'Shipping container rental tips' -%}{{ section.settings.tips_image | image_url: width: 365 | image_tag: class: 'uc-rent-guide__img', alt: uc_alt, loading: 'lazy' }}
        {%- elsif section.settings.tips_fallback_image_url != blank -%}
          {%- render 'uc-img', src: section.settings.tips_fallback_image_url, class: 'uc-rent-guide__img', alt: 'Shipping container rental tips', widths: '365,548,730', sizes: '(min-width: 990px) 365px, 80vw' -%}
        {%- endif -%}
      </div>
    </div>

    <div class="uc-rent-guide__row uc-rent-guide__row--reverse">
      <div class="uc-rent-guide__media uc-rent-guide__media--checklist">
        {%- if section.settings.checklist_image != blank -%}
          {%- assign uc_alt = section.settings.checklist_image.alt | default: section.settings.heading | default: section.settings.title | default: 'Shipping container rental checklist' -%}{{ section.settings.checklist_image | image_url: width: 463 | image_tag: class: 'uc-rent-guide__img', alt: uc_alt, loading: 'lazy' }}
        {%- elsif section.settings.checklist_fallback_image_url != blank -%}
          {%- render 'uc-img', src: section.settings.checklist_fallback_image_url, class: 'uc-rent-guide__img', alt: 'Shipping container rental checklist', widths: '463,694,926', sizes: '(min-width: 990px) 463px, 80vw' -%}
        {%- endif -%}
      </div>
      <div class="uc-rent-guide__col">
        <ul class="uc-rent-guide__list uc-rent-guide__list--wide">
          {%- for block in section.blocks -%}
            {%- if block.type == 'paperwork' -%}
              <li {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b> {{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>

    <p class="uc-rent-guide__kicker uc-rent-guide__kicker--full">{{ section.settings.flex_kicker }}</p>
    <p class="uc-rent-guide__para uc-rent-guide__para--full">{{ section.settings.flex_text }}</p>
    <ul class="uc-rent-guide__list uc-rent-guide__list--full">
      {%- for block in section.blocks -%}
        {%- if block.type == 'flex' -%}
          <li {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b> {{ block.settings.text }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <h2 class="uc-rent-guide__title uc-rent-guide__rule uc-rent-guide__title--sub">{{ section.settings.types_heading }}</h2>
    <div class="uc-rent-types__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'container_type' -%}
          <div class="uc-rent-types__card uc-rent-types__card--{{ block.settings.style }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 462 | image_tag: class: 'uc-rent-types__img', alt: block.settings.title, loading: 'lazy' }}
            {%- elsif block.settings.fallback_image_url != blank -%}
              {%- render 'uc-img', src: block.settings.fallback_image_url, class: 'uc-rent-types__img', alt: block.settings.title, widths: '311,462,622', sizes: '311px' -%}
            {%- endif -%}
            <h3 class="uc-rent-types__title">{{ block.settings.title }}</h3>
            <p class="uc-rent-types__desc">{{ block.settings.description }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

