{%- comment -%} Used Conex — Frequently Asked Questions accordion {%- endcomment -%}{%- render 'uc-section-style', section: section -%}


<section class="uc-section uc-font">
  <div class="uc-wrap">
    <h2 class="uc-section-title">{{ section.settings.heading }}</h2>
    <p class="uc-faq__intro">{{ section.settings.intro }}</p>
    <div class="uc-faq__list">
      {%- assign mf_faq = page.metafields.location.faq_json.value -%}
      {%- if mf_faq != blank -%}
        {%- for item in mf_faq -%}
          <details class="uc-faq__item"{% if forloop.first %} open{% endif %}>
            <summary class="uc-faq__question">
              {{ item.question }}
              <span class="uc-faq__icon" aria-hidden="true">
                <svg class="uc-faq__icon-plus" viewBox="0 0 19.5 19.5" fill="none"><path d="M9.74609 1V18.5" stroke="#EBB808" stroke-width="2" stroke-linecap="round"/><path d="M18.5 9.74512L1 9.74512" stroke="#EBB808" stroke-width="2" stroke-linecap="round"/></svg>
                <svg class="uc-faq__icon-minus" viewBox="0 0 19.5 19.5" fill="none"><path d="M18.5 9.74512L1 9.74512" stroke="#EBB808" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
            </summary>
            <div class="uc-faq__answer"><p>{{ item.answer }}</p></div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <details class="uc-faq__item" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
            <summary class="uc-faq__question">
              {{ block.settings.question }}
              <span class="uc-faq__icon" aria-hidden="true">
                <svg class="uc-faq__icon-plus" viewBox="0 0 19.5 19.5" fill="none"><path d="M9.74609 1V18.5" stroke="#EBB808" stroke-width="2" stroke-linecap="round"/><path d="M18.5 9.74512L1 9.74512" stroke="#EBB808" stroke-width="2" stroke-linecap="round"/></svg>
                <svg class="uc-faq__icon-minus" viewBox="0 0 19.5 19.5" fill="none"><path d="M18.5 9.74512L1 9.74512" stroke="#EBB808" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
            </summary>
            <div class="uc-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{%- assign uc_faq_sep = '' -%}
<script type="application/ld+json">
{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
{%- for block in section.blocks -%}
  {%- if block.settings.question != blank and block.settings.answer != blank -%}
  {{ uc_faq_sep }}{"@type": "Question", "name": {{ block.settings.question | strip | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ block.settings.answer | strip_html | strip_newlines | strip | json }}}}
  {%- assign uc_faq_sep = ',' -%}
  {%- endif -%}
{%- endfor -%}
]}
</script>

