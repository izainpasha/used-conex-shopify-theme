    "info": {
      "type": "uc-buy-info-blocks",
      "blocks": {
        "i1": {
          "type": "block",
          "settings": {
            "heading": "What Are Shipping Containers?",
            "body": "<p>Shipping containers are steel structures designed for transporting goods across long distances, typically by sea, land, or rail. However, these durable containers have grown in popularity for a variety of uses beyond shipping, such as storage, construction, and even as living spaces.</p><p>They come in various sizes, from 10ft to 40ft, with the most common being 20ft and 40ft standard containers (which is what we at Used Conex offer). Their standard dimensions make them ideal for stacking, and they are capable of withstanding harsh weather conditions, ensuring that your items remain safe and secure.</p>"
          }
        },
        "i2": {
          "type": "block",
          "settings": {
            "heading": "Different Types of Shipping Containers for Sale",
            "body": "<p>At UsedConex, we offer a wide variety of shipping containers to meet your needs. Whether you’re using them for storage, shipping, or custom modifications, we have options to suit every project.</p><ul><li>Standard Shipping Containers: Ideal for general storage and shipping, available in 20ft and 40ft sizes.</li><li>High-Cube Containers: These containers are taller than standard ones, offering more storage space.</li></ul><p>Each container type serves a unique purpose, so be sure to consider your needs when selecting the right one for your project.</p>"
          }
        }
      },
      "block_order": [
        "i1",
        "i2"
      ],
      "settings": {}
    },
    "info_cta": {
      "type": "uc-buy-info-cta",
      "settings": {
        "fallback_image_url": "https://cdn.shopify.com/s/files/1/1029/2284/6530/files/uc-buy-containers-photo.jpg",
        "heading": "Need more information?",
        "text": "Let us take you through the process TO BUY A SHIPPING CONTAINER from start to finish.",
